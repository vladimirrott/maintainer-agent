# Every tunable's default, in one place. Sourced by lib/profile.sh and read by
# the python tools, never run.
#
# Precedence, highest first:
#   1. the environment variable MAINTAINER_<KEY>, for one invocation
#   2. a verify.d/<suite>.sh declaration, for the VERIFY_* resource keys only
#   3. the key in a profile's profile.env
#   4. the value here
#
# Plain KEY=value, no quotes and no spaces, with a comment on the line above:
# bash sources this file and python parses it with one regex. Add a key here
# and in docs/configuration.md together; tests/run-tests.sh fails when either
# is missing.

# Container memory for a verify run (clean, mutated and fetch). A suite whose
# build needs more declares suite_memory in its own verify.d file instead of
# raising this for every suite: 2g OOM-kills rustc on a large cargo workspace.
VERIFY_MEMORY=2g

# CPUs for the clean and mutated verify runs.
VERIFY_CPUS=2

# Process limit inside a verify container, so a fork bomb hits a wall.
VERIFY_PIDS=512

# Size of the /tmp tmpfs inside a verify container.
VERIFY_TMPFS=256m

# Seconds one clean or mutated verify container may run before podman kills it.
VERIFY_TIMEOUT=1800

# Seconds the networked dependency fetch before a verify may run.
PREFETCH_TIMEOUT=900

# Seconds added to the MCP verify call's deadline on top of what the containers
# may take (two verify runs plus one fetch), for extracting the tree and the
# receipt. The MCP deadline is derived, never typed.
MCP_VERIFY_SLACK=300

# Seconds a run waits for the shared lock before giving up. Keep it below the
# systemd unit's TimeoutStartSec (platform/linux/maintainer@.service): the
# wait is part of that budget, so a longer wait is killed by systemd first.
LOCK_WAIT=3600

# Days `maintainer gc` keeps logs and drafts. runs/ and index.md are never pruned.
RETENTION_DAYS=90

# Days of silence after which `maintainer claims` marks a claimed issue stale.
CLAIM_STALE_DAYS=7

# Days of silence after which `maintainer stale` names a hold. Longer than the
# claim window on purpose: an offer is a softer promise than a claim label.
STALE_HOLD_DAYS=9

# Rows requested from every gh list that must be complete. A listing that comes
# back exactly this long may have been cut off, and the command refuses.
GH_LIST_LIMIT=1000

# Merged pull requests read to find past contributors. A recency window, not a
# completeness requirement, so filling it is expected and is not an error.
CONTRIBUTOR_WINDOW=300

# Attempts run.sh makes to reach GitHub before it gives up and records an
# exit-75 failure for the catch-up slot to retry.
GH_TRIES=3

# Seconds between those attempts.
GH_BACKOFF=20

# Hours main may stay red before maintainer-doctor fails instead of warning. A
# run that failed this recently may already have a fix on the way.
RED_GRACE_HOURS=6

# Workflow runs maintainer-doctor reads when it asks whether main is red.
DOCTOR_RUN_LIMIT=40

# Fewest rules a rendered deny wall may hold before maintainer-doctor calls it
# stale. A floor, not a count: the wall is generated from deny.json.
DENY_WALL_MIN_RULES=100

# Seconds a `maintainer lease take` holds a pull request when --ttl is not
# given. A lease nobody renews frees itself after this long, so a session that
# died cannot keep a PR blocked.
LEASE_TTL_SECONDS=3600

# Hours since a lease was last renewed before maintainer-doctor calls it
# forgotten. Longer than any normal TTL on purpose: a lease older than this
# belongs to a session that ended without `lease release`.
DOCTOR_LEASE_HOURS=12

# Model the opencode backend uses when the profile names a Claude model.
OPENCODE_MODEL=groq/openai/gpt-oss-120b

# Non-empty lines a run report needs below its heading before `finish` indexes
# it. lib/preamble-core.md asks a quiet run for exactly this many; the suite
# fails when the two disagree, as they did from 2026-09-04 to 2026-10-25 (#133).
REPORT_MIN_LINES=3

# Days an author must be silent after a review before `maintainer stalled` lists
# the pull request. The owner's default of 10 is more than twice the slowest
# reply on lacs-project/sysknife: of 23 pull requests with a CHANGES_REQUESTED
# review (read 2026-10-26), 8 got a comment or review back, all within 4.0 days;
# pushes were not counted.
FIXUP_QUIET_DAYS=10

# Days between the heads-up comment and the push, on top of the quiet window. 5
# covers the slowest of those 8 replies (4.0 days) and a weekend, so an author
# who is merely slow still gets to push first.
FIXUP_NOTICE_DAYS=5

# Most lines (added plus deleted) a fixup patch may change. 20 is five times the
# 4 lines that each of the 39 commits moving this repo's README test count changed,
# room for the count to appear in a second place and no room for a code change.
FIXUP_MAX_LINES=20

# Which Dependabot bumps `maintainer deps` may send to `verify` once they are
# green and current: none, patch (every member semver-patch) or minor (patch or
# minor). A semver-major member always goes to a person, whatever this says.
DEPS_AUTOMERGE=minor

# Reads `maintainer deps` makes of a pull request's merge state while GitHub
# answers UNKNOWN, which means it has not finished computing it after a push.
DEPS_UNKNOWN_READS=3

# Seconds between those reads.
DEPS_UNKNOWN_WAIT=5
