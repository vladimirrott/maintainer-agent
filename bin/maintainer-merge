#!/usr/bin/env bash
# Merge a pull request, but only against a recorded verification.
#
#   maintainer-merge receipt <pr> <head-sha> <what-was-proved>
#   maintainer-merge merge   <pr>
#   maintainer-merge show    [pr]
#
# The point is not to merge. The point is that a merge is impossible unless
# somebody proved the guard bites, at a head whose production code is identical
# to the one being merged. A green board is not that proof: this repository's
# recurring defect is a test that stays green with the fix reverted.
set -uo pipefail

. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/profile.sh" 2>/dev/null \
  || . "$HOME/.local/share/maintainer/profile.sh"
maintainer_load_profile || exit 64
REPO_SLUG="$MAINTAINER_SLUG"
REPO_PATH="$MAINTAINER_REPO"
STATE="$MAINTAINER_STATE"
ACCOUNT="$MAINTAINER_ACCOUNT"
RECEIPTS="$STATE/receipts"
# Same reasoning as maintainer-repo: `gh pr merge` runs inside this script, so
# no Bash deny rule sees it. Without this, a POST=off rehearsal could merge a
# pull request while reporting that it reached nobody.
POST="${MAINTAINER_POST:-on}"
# Paths whose change invalidates a receipt. Tests, docs and the evidence
# artifact may move between the verified head and the merged one; production
# code and CI configuration may not.
# Paths whose change invalidates a receipt. Tests, docs and evidence artifacts
# may move between the verified head and the merged one; production code and CI
# configuration may not.
#
# This was a hardcoded list of sysknife's directories, which meant that on every
# other repository it named paths that do not exist. A pull request could earn a
# receipt at one head, then push a rewritten bin/ or lib/ at the next, and the
# gate would report "no production diff; receipt still applies" because bin/ was
# not on sysknife's list. That is a merge against a receipt describing a tree
# that is gone, which is the exact failure the receipt exists to prevent.
#
# It comes from the profile now, and a profile that does not declare it gets no
# merge. There is no default: guessing which paths are production is how the
# original bug worked.
read -r -a PROD_GLOBS <<< "${PROD_GLOBS:-}"

die() { printf 'maintainer-merge: %s\n' "$1" >&2; exit 1; }

# A receipt is signed, and merge recomputes the signature.
#
# It used to be an unsigned JSON file whose only protection was a deny rule on
# one CLI verb. The deny wall emits Bash() and Read() rules and nothing else, so
# an agent holding an ordinary write tool could create
# `$RECEIPTS/<pr>.json` by hand, with `"kind": "observed"`, and merge without
# ever running a mutation. That is SECURITY.md's own first named threat.
#
# Now the payload is signed with a key minted by install.sh at mode 0600, which
# the wall denies to every reader it knows how to spell. Forging a receipt takes
# the key, not a text editor. This is not unbreakable: an agent that can read the
# key can still sign one, which is why the key is 0600, outside the repository,
# and never printed. It moves the bar from "write a file" to "defeat the wall
# AND the file mode".
RECEIPT_KEY="${MAINTAINER_RECEIPT_KEY:-$HOME/.local/share/maintainer/receipt.key}"

receipt_sign() {  # stdin: the canonical payload -> hex signature
    [ -f "$RECEIPT_KEY" ] || die "no receipt key at $RECEIPT_KEY; run ./install.sh"
    python3 -c "
import hmac, hashlib, sys, pathlib
key = pathlib.Path(sys.argv[1]).read_text().strip().encode()
print(hmac.new(key, sys.stdin.buffer.read(), hashlib.sha256).hexdigest())
" "$RECEIPT_KEY"
}

# Both writers end here. The signature covers the payload exactly as it sits on
# disk, so any later edit invalidates it, and `merge` recomputes this same form.
receipt_seal() {  # $1 = receipt path
    local sig; sig="$(receipt_sign < "$1")" || exit 1
    python3 - "$1" "$sig" <<'PYEOF'
import json, sys
p, sig = sys.argv[1], sys.argv[2]
d = json.load(open(p)); d["signature"] = sig
json.dump(d, open(p, "w"), indent=2)
PYEOF
}
say() { printf '  %s\n' "$1"; }

identity() {
    gh auth switch --hostname github.com --user "$ACCOUNT" >/dev/null 2>&1
    local who; who="$(gh api user --jq .login 2>/dev/null)"
    [ "$who" = "$ACCOUNT" ] || die "gh is authenticated as '${who:-unknown}', not $ACCOUNT"
}

# `receipt` records a claim. `verify` produces one by running the mutation and
# observing the outcome, and it is the only form an unattended agent may use.
#
# The distinction is the whole gate. A hand-written receipt asserts "I mutated
# the guard and it went red"; nothing checks that. An agent under pressure, or
# one that simply skipped a step, can write that sentence as easily as a true
# one. `verify` runs the test twice, unmutated and mutated, and records what it
# saw. The agent still chooses a weak mutation if it wants to, but it cannot
# fabricate the result.
cmd_receipt() {
    local pr="${1:?pr}" sha="${2:?head sha}" proof="${3:?what was proved}"
    # An unattended run may not assert. `verify` is the only receipt an agent can
    # earn, because only `verify` watches the mutation fail. Three layers say so:
    # this one, a deny rule on the command, and a refusal in `merge` for any
    # receipt that is not `observed` while a run is in progress. The first two
    # are evadable by an agent that unsets a variable or spells a path
    # differently; the third is not, which is why it exists.
    [ -z "${MAINTAINER_IN_RUN:-}" ] || die "an unattended run may not assert a receipt.
  Only \`maintainer-merge verify\` earns one, because only it observes the
  mutation. If this pull request cannot be mutation-proven, say so in the report
  and leave the merge to a human."
    mkdir -p "$RECEIPTS"
    [ ${#sha} -ge 7 ] || die "head sha looks truncated: $sha"
    # Built by json.dump rather than a heredoc. The heredoc interpolated the
    # proof string straight into JSON, so a proof containing a quote or a
    # newline wrote a file the merge gate could not parse, and the refusal
    # blamed the receipt rather than the quoting.
    python3 - "$RECEIPTS/$pr.json" "$pr" "$sha" "$proof" <<'PYEOF' || die "could not record the receipt (is '$pr' a pull request number?)"
import json, sys, datetime, getpass
out, pr, head, proof = sys.argv[1:5]
json.dump({
    "pr": int(pr), "head": head, "kind": "asserted", "proof": proof,
    "recorded_at": datetime.datetime.now().astimezone().isoformat(),
    "recorded_by": getpass.getuser(),
}, open(out, "w"), indent=2)
PYEOF
    receipt_seal "$RECEIPTS/$pr.json"
    say "receipt recorded for #$pr at $sha (asserted, not observed)"
}

# maintainer-merge verify <pr> <head-sha> <test-filter> <sed-mutation> [crate]
#
# Runs the test filter in podman against the PR head, then again with the
# mutation applied, and records a receipt only if it passed clean and failed
# mutated. Either other outcome is a refusal, including the one that matters
# most: a test that stays green when the guard is removed.
# maintainer-merge verify <pr> <head-sha> <test filter> <sed mutation> [suite]
#
# Runs the filter in podman against the PR head, then again with the mutation
# applied, and records a receipt only if it passed clean and failed mutated.
# Either other outcome is a refusal, including the one that matters most: a test
# that stays green when the guard is removed.
#
# The suite comes from the profile (profiles/<name>/verify.d/*.sh) and is
# inferred from the paths the pull request touches. This used to be hardcoded to
# Rust in four places, so a pull request touching only shell scripts could never
# earn a receipt and therefore could never merge. See issue #11: it took a live
# contributor PR to find, because refusing to merge is the safe outcome and
# nothing looked wrong until somebody wanted the merge.
suite_dir() {
    local here; here="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
    for d in "${PROFILE_DIR:-}/verify.d" \
             "$HOME/.local/share/maintainer/profiles/${MAINTAINER_PROFILE:-}/verify.d" \
             "$here/../profiles/${MAINTAINER_PROFILE:-}/verify.d"; do
        case "$d" in /verify.d) continue ;; esac
        [ -d "$d" ] && { printf '%s' "$d"; return 0; }
    done
    return 1
}

# Which suite covers these paths? Named explicitly, or inferred, or refused.
pick_suite() {  # $1 = named suite or empty, $2... = changed paths
    local named="$1"; shift
    local dir; dir="$(suite_dir)" || die "this profile declares no verify.d/ suites; see docs/verifying.md"
    if [ -n "$named" ]; then
        [ -f "$dir/$named.sh" ] || die "no suite '$named' in $dir"
        # Naming a suite used to skip this entirely, and the name is reachable
        # from an MCP client. A receipt from a suite that does not run the
        # changed code proves nothing, whether the suite was inferred or asked
        # for by name.
        # shellcheck disable=SC1090
        ( . "$dir/$named.sh"; for p in "$@"; do suite_covers "$p" || exit 1; done ) \
            || die "the '$named' suite does not cover every changed path:
$(printf '    %s\n' "$@")
  A receipt from a suite that does not run the changed code proves nothing."
        printf '%s' "$named"; return 0
    fi
    local s name covered=""
    for s in "$dir"/*.sh; do
        [ -e "$s" ] || continue
        name="$(basename "$s" .sh)"
        # shellcheck disable=SC1090
        ( . "$s"; for p in "$@"; do suite_covers "$p" || exit 1; done ) && { covered="$name"; break; }
    done
    [ -n "$covered" ] || die "no suite in $dir covers every changed path:
$(printf '    %s\n' "$@")
  Add one, or name a suite explicitly. A receipt written by a suite that does
  not run the changed code proves nothing."
    printf '%s' "$covered"
}

# podman if it is there, docker otherwise. Requiring podman meant a contributor
# with docker could not run the gate at all, and CI has docker.
container_runtime() {
    if command -v podman >/dev/null 2>&1; then printf 'podman'
    elif command -v docker >/dev/null 2>&1; then printf 'docker'
    else return 1; fi
}

cmd_verify() {
    local pr="${1:?pr}" sha="${2:?head sha}" filter="${3:?test filter}" mutation="${4:?sed expression}"
    local named="${5:-}"
    [ ${#sha} -ge 7 ] || die "head sha looks truncated: $sha"
    local rt; rt="$(container_runtime)" || die "no container runtime; install podman or docker. No container, no receipt."

    local paths; paths="$(gh pr view "$pr" --repo "$REPO_SLUG" --json files --jq '.files[].path')"
    [ -n "$paths" ] || die "could not read the changed files for #$pr"
    local -a path_list; mapfile -t path_list <<< "$paths"
    local suite; suite="$(pick_suite "$named" "${path_list[@]}")" || exit 1
    local dir; dir="$(suite_dir)"
    # shellcheck disable=SC1090
    . "$dir/$suite.sh"
    # A suite may need a runtime feature the other lacks, and saying so beats a
    # confusing mount error.
    if declare -F suite_requires >/dev/null && ! suite_requires "$rt"; then
        die "the '$suite' suite needs $(suite_requires_name), and this machine has $rt"
    fi
    say "suite: $suite ($(suite_image) under $rt)"

    local work; work="$(mktemp -d)"
    trap 'rm -rf "$work"' RETURN
    git -C "$REPO_PATH" fetch -q origin "refs/pull/$pr/head:v-$pr" --force || die "cannot fetch #$pr"
    local real_head; real_head="$(git -C "$REPO_PATH" rev-parse "v-$pr")"
    case "$real_head" in "$sha"*) ;; *) git -C "$REPO_PATH" branch -D "v-$pr" >/dev/null 2>&1
        die "head is $real_head, not the $sha you named" ;; esac
    git -C "$REPO_PATH" archive "v-$pr" | tar -x -C "$work"
    git -C "$REPO_PATH" branch -D "v-$pr" >/dev/null 2>&1

    # A pull request may not ship a symlink into a tree this gate then edits.
    #
    # The mutation step below runs on the HOST, outside the container. A tracked
    # symlink `harness.sh -> ~/.ssh/id_ed25519` survives `git archive | tar -x`,
    # and `sed -i` follows it: the key's plaintext is written into the extracted
    # tree, which is then bind-mounted into the container where the pull
    # request's own test can print it, and 200 characters of it land in the
    # receipt. Reproduced end to end. Every container flag is irrelevant to it,
    # because the read happens before the container exists.
    local links; links="$(find "$work" -type l -printf '%P -> %l\n' 2>/dev/null)"
    if [ -n "$links" ]; then
        die "#$pr ships symlink(s) into the tree this gate edits, and the mutation
  step would follow them off the host:
$(printf '%s\n' "$links" | sed 's/^/    /')
  Refusing. Review this by reading."
    fi
    mkdir -p "$work/.container-target"

    # Every control here is measured by tests/containment-probe.sh with a real
    # adversarial payload, not assumed from the flag being present.
    #
    #   --network=none          the payload cannot phone home or fetch a stage 2
    #   --cap-drop=ALL          no CAP_NET_RAW, no CAP_SYS_ADMIN, nothing
    #   no-new-privileges       a setuid binary inside cannot elevate
    #   --read-only             the image is immutable; only the mounts are not
    #   --tmpfs /tmp noexec     scratch space that cannot be executed from
    #   --pids-limit            a fork bomb hits a wall instead of the host
    #   --memory, --cpus        a balloon or a spin cannot starve the machine
    #   --timeout               an infinite loop cannot hold a timer for ever.
    #                           This is podman's own flag, enforced by conmon.
    #                           GNU `timeout` around the client does NOT work:
    #                           it kills the CLI and leaves the container
    #                           running. Measured, with two containers still
    #                           spinning three minutes later and load at 5.5.
    #
    # What this is NOT: a boundary against a kernel exploit. Containers share
    # the host kernel, and the 2026 consensus is that untrusted code deserves a
    # user-space kernel (gVisor) or a micro-VM. docs/containment.md says so and
    # says what it would take to get there.
    run_in_container() {
        # shellcheck disable=SC2046
        "$rt" run --rm \
            --timeout "${MAINTAINER_VERIFY_TIMEOUT:-1800}" \
            --network=none \
            --cap-drop=ALL \
            --security-opt=no-new-privileges \
            --read-only \
            --tmpfs /tmp:rw,noexec,nosuid,size=256m \
            --pids-limit "${MAINTAINER_VERIFY_PIDS:-512}" \
            --memory "${MAINTAINER_VERIFY_MEMORY:-2g}" \
            --cpus "${MAINTAINER_VERIFY_CPUS:-2}" \
            -v "$work:/repo:z" $(suite_podman_args) \
            -w /repo "$(suite_image)" \
            sh -c "$(suite_command "$filter")" >>"$1" 2>&1
    }

    local clean_log="$work/clean.log" mut_log="$work/mutated.log"
    say "running '$filter' unmutated"
    run_in_container "$clean_log"; local clean_rc=$?
    [ "$clean_rc" = 0 ] || die "the test does not pass unmutated (rc=$clean_rc); nothing to prove yet
$(tail -5 "$clean_log" | sed 's/^/    /')"

    # A filter that matches nothing "passes". Without this the gate can write a
    # receipt having executed zero tests: the clean run passes vacuously, and a
    # mutation that merely breaks compilation makes the second run fail, which
    # reads as proof. Each suite says how to count; a suite that cannot say gets
    # no receipt.
    local ran; ran="$(suite_ran "$clean_log")"
    [ "${ran:-0}" -ge 1 ] || die "'$filter' produced no evidence it ran anything; a vacuous pass proves nothing
$(tail -3 "$clean_log" | sed 's/^/    /')"
    say "$suite suite: evidence of $ran executed unit(s), passing unmutated"

    say "applying the mutation and re-running"
    # The mutation is applied inside the extracted tree only. The real
    # repository is never touched.
    # -type f as well as the refusal above: `sed -i` on a symlink replaces it
    # with the dereferenced content, so this must never see one.
    ( cd "$work" && find . -type f -name "$(suite_mutate_glob)" \
        -not -path './.container-target/*' -print0 \
        | xargs -0 sed -i "$mutation" ) || die "mutation failed to apply"
    run_in_container "$mut_log"; local mut_rc=$?

    if [ "$mut_rc" = 0 ]; then
        die "THE GUARD DOES NOT BITE: '$filter' still passes with the mutation applied.
  This is the defect the gate exists for. No receipt written."
    fi

    mkdir -p "$RECEIPTS"
    python3 - "$RECEIPTS/$pr.json" "$pr" "$real_head" "$filter" "$mutation" "$mut_rc" \
        "$(grep -m1 -E 'panicked at|assertion|FAILED|Error|error' "$mut_log" | cut -c1-200)" \
        "$suite" "$ran" <<'PYEOF'
import json, sys, datetime, getpass
out, pr, head, filt, mut, rc, msg = sys.argv[1:8]
suite, ran = sys.argv[8], sys.argv[9]
json.dump({
    "pr": int(pr), "head": head, "kind": "observed",
    "suite": suite, "units_run": ran,
    "proof": f"`{filt}` passes clean and fails under `{mut}` (rc={rc})",
    "mutation": mut, "filter": filt, "observed_failure": msg,
    "recorded_at": datetime.datetime.now().astimezone().isoformat(),
    "recorded_by": getpass.getuser(),
}, open(out, "w"), indent=2)
PYEOF
    receipt_seal "$RECEIPTS/$pr.json"
    say "receipt recorded for #$pr at ${real_head:0:8} (observed: clean pass, mutated fail)"
}

cmd_show() {
    mkdir -p "$RECEIPTS"
    if [ $# -ge 1 ]; then cat "$RECEIPTS/$1.json" 2>/dev/null || die "no receipt for #$1"; return; fi
    local n=0
    for f in "$RECEIPTS"/*.json; do [ -e "$f" ] || continue; n=$((n+1)); printf '  %s\n' "$(basename "$f" .json): $(python3 -c "import json,sys;d=json.load(open('$f'));print(d['head'][:8], d['proof'][:60])")"; done
    [ "$n" = 0 ] && say "no receipts recorded"
    return 0
}

cmd_merge() {
    local pr="${1:?pr}"
    [ "${#PROD_GLOBS[@]}" -gt 0 ] || die "this profile declares no PROD_GLOBS, so nothing can say
  whether production code moved since the receipt. Set it in profile.env, for example:
    PROD_GLOBS=\"bin/* lib/* scripts/* .github/*\""
    identity

    local receipt="$RECEIPTS/$pr.json"
    [ -f "$receipt" ] || die "no verification receipt for #$pr. Prove the guard bites, then: maintainer-merge receipt $pr <sha> '<proof>'"
    # Recompute the signature over the payload with the signature removed. An
    # unsigned or hand-edited receipt is refused here, which is the whole point.
    local payload sig want
    payload="$(python3 - "$receipt" <<'PYEOF'
import json, sys
d = json.load(open(sys.argv[1]))
d.pop("signature", None)
json.dump(d, sys.stdout, indent=2)
PYEOF
)" || die "receipt for #$pr is not readable JSON"
    sig="$(python3 -c "import json,sys;print(json.load(open(sys.argv[1])).get('signature',''))" "$receipt")"
    [ -n "$sig" ] || die "the receipt for #$pr carries no signature, so it was not written by
  \`maintainer-merge verify\`. A receipt that anything can write proves nothing.
  Run: maintainer-merge verify $pr <head> <test> <mutation>"
    want="$(printf '%s' "$payload" | receipt_sign)"
    [ "$sig" = "$want" ] || die "the receipt for #$pr does not match its signature: it was edited
  after it was written, or written by something other than the gate."
    local verified_head kind
    verified_head="$(python3 -c "import json;print(json.load(open('$receipt'))['head'])")"
    kind="$(python3 -c "import json;print(json.load(open('$receipt')).get('kind',''))")"
    # The layer that is not evadable. An asserted receipt is a human's claim
    # that a guard bites; nothing checked it. A human may merge on one. An
    # unattended run may not, whatever it managed to write.
    if [ -n "${MAINTAINER_IN_RUN:-}" ] && [ "$kind" != observed ]; then
        die "the receipt for #$pr is '$kind', not 'observed'. An unattended run merges
  only on a receipt \`maintainer-merge verify\` produced by watching the
  mutation fail."
    fi
    [ "$kind" = observed ] || say "the receipt is ASSERTED, not observed: it records a claim a
     human made, and nothing here checked it"

    local head state review
    head="$(gh pr view "$pr" --repo "$REPO_SLUG" --json headRefOid --jq .headRefOid)"
    state="$(gh pr view "$pr" --repo "$REPO_SLUG" --json mergeStateStatus --jq .mergeStateStatus)"
    review="$(gh pr view "$pr" --repo "$REPO_SLUG" --json reviewDecision --jq .reviewDecision)"

    [ "$review" = "APPROVED" ] || die "#$pr reviewDecision is '$review', not APPROVED"

    # mergeStateStatus was fetched and thrown away for as long as this gate has
    # existed, which shellcheck found by noticing the variable was never read.
    # BEHIND is the one that matters: the branch is not up to date with its
    # base, so every green check describes a tree that is not the one being
    # merged, which is the failure this whole gate is about. DIRTY is a
    # conflict, BLOCKED means a required review or check is missing.
    case "$state" in
        CLEAN|HAS_HOOKS) ;;
        BEHIND)  die "#$pr is BEHIND its base; its checks describe a different tree. Update the branch and let it re-run." ;;
        DIRTY)   die "#$pr has conflicts (mergeStateStatus DIRTY)" ;;
        BLOCKED) die "#$pr is BLOCKED: a required review or check is missing" ;;
        *)       die "#$pr mergeStateStatus is '$state'; only CLEAN and HAS_HOOKS may merge" ;;
    esac

    local checks fails pend
    checks="$(gh pr checks "$pr" --repo "$REPO_SLUG" --json name,bucket 2>/dev/null)"
    [ -n "$checks" ] || die "#$pr reported no checks at all; refusing"
    fails="$(printf '%s' "$checks" | jq '[.[]|select(.bucket=="fail")]|length')"
    pend="$(printf '%s' "$checks"  | jq '[.[]|select(.bucket=="pending")]|length')"
    [ "$fails" = 0 ] || die "#$pr has $fails failing check(s)"
    [ "$pend"  = 0 ] || die "#$pr has $pend pending check(s)"

    # The condition that carries the weight. A rebase may move tests, docs and
    # the evidence artifact; if it moved production code, the receipt describes
    # a tree that no longer exists.
    git -C "$REPO_PATH" fetch -q origin "refs/pull/$pr/head:mm-$pr" --force || die "cannot fetch #$pr"
    if [ "$head" != "$verified_head" ]; then
        local diff
        diff="$(git -C "$REPO_PATH" diff --name-only "${verified_head}..mm-$pr" -- "${PROD_GLOBS[@]}" 2>/dev/null)"
        if [ -n "$diff" ]; then
            git -C "$REPO_PATH" branch -D "mm-$pr" >/dev/null 2>&1
            die "production code changed since the verified head $verified_head:
$(printf '%s' "$diff" | sed 's/^/    /')
  The receipt no longer describes this tree. Re-verify and record a new one."
        fi
        say "head moved $verified_head -> ${head:0:8}, no production diff; receipt still applies"
    fi
    git -C "$REPO_PATH" branch -D "mm-$pr" >/dev/null 2>&1

    say "#$pr: approved, $(printf '%s' "$checks" | jq '[.[]|select(.bucket=="pass")]|length') checks pass, 0 fail, 0 pending, receipt valid"
    if [ "$POST" = off ]; then
        say "POST=off: every condition holds and the merge is NOT being made"
        say "         re-run with posting on to land it"
        return 0
    fi
    # Pinned to the head that was checked. Without --match-head-commit a push
    # landing between the production diff above and this line is merged
    # unchecked, because `gh pr merge` merges whatever is current when it runs.
    gh pr merge "$pr" --repo "$REPO_SLUG" --squash --delete-branch \
        --match-head-commit "$head" || die "merge failed"
    say "merged #$pr"
    rm -f "$receipt"
}

case "${1:-}" in
    receipt) shift; cmd_receipt "$@" ;;
    verify)  shift; cmd_verify "$@" ;;
    merge)   shift; cmd_merge "$@" ;;
    show)    shift; cmd_show "$@" ;;
    *) printf 'usage: maintainer-merge {verify <pr> <sha> <test-filter> <sed-mutation> [crate]|receipt <pr> <sha> <proof>|merge <pr>|show [pr]}\n' >&2; exit 64 ;;
esac
