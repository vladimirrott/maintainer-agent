#!/usr/bin/env python3
"""Refresh the sysknife checkout and keep an auditable record of each maintenance run.

    maintainer version                         which build is deployed, and whether it is stale
    maintainer status                          what has run, what is due, is it posting
    maintainer run [--show-prompt] <task>      run one task now, or print its prompt
    maintainer start  <task>                   refresh, diff against the last run, open a report
    maintainer finish <run_id>                 close the run and append it to the index
    maintainer screen <pr>                     may this PR be built on the host?
    maintainer log    [n]                      show the last n runs

`start` refuses to touch a dirty tree. It never stashes, resets or force-updates
anything: a run that would have to discard local work is a run that stops and
says so, because the alternative is losing someone's uncommitted change to a
scheduled job.
"""
from __future__ import annotations

import json
import os
import re
import shutil
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path

# Profile-driven, in this order: the environment run.sh exports, then the
# DEPLOYED profile.env, then a default.
#
# The middle step is what makes a direct call correct. `maintainer status` used
# to read the profile's name and POST setting from its profile.env while taking
# the repository, the state directory and the task list from module-level
# defaults, so a second profile printed its own header above the FIRST
# profile's repository and run history. An adopter would have read another
# project's runs and believed they were theirs.
def _resolve_profile() -> str:
    """Which profile, or refuse.

    This was `os.environ.get("MAINTAINER_PROFILE", "sysknife")`: a hardcoded
    default while lib/profile.sh and maintainer-doctor both enumerate and
    refuse. With two profiles deployed and the variable unset, `maintainer
    status` reported the wrong one and `maintainer run review` would have
    started a real, posting run against the wrong repository. Guessing which
    project to act on is the mistake this whole resolution exists to prevent.
    """
    named = os.environ.get("MAINTAINER_PROFILE")
    if named:
        return named
    root = Path.home() / ".local/share/maintainer/profiles"
    found = sorted(d.name for d in root.glob("*") if (d / "profile.env").exists()) \
        if root.exists() else []
    if len(found) == 1:
        return found[0]
    if not found:
        return ""            # nothing deployed; the commands say so themselves
    raise SystemExit(
        f"maintainer: {len(found)} profiles are deployed ({', '.join(found)}).\n"
        f"            Set MAINTAINER_PROFILE to say which one you mean.")


PROFILE = _resolve_profile()
# A profile name becomes a path AND, below, part of a shell command. Both need
# it to be a plain name. Measured on 2026-09-03: MAINTAINER_PROFILE set to
# `pwn"; touch /tmp/INJECTED; :"` with a matching directory ran the touch,
# because the name was interpolated into `bash -c` and `path.exists()` guards
# nothing when whoever sets the variable also creates the directory. That is
# arbitrary shell inside a subprocess the deny wall never sees.
_SAFE_NAME = re.compile(r"^[A-Za-z0-9._-]+$")
if not _SAFE_NAME.match(PROFILE):
    raise SystemExit(f"maintainer: refusing a profile name that is not a plain "
                     f"word: {PROFILE!r}")


def deployed_version() -> dict:
    """What the DEPLOYED tree says it is, and whether the checkout has moved on.

    Never `git describe` here. The checkout can be ahead of what is installed,
    so reporting it would name a build that is not running, and "but I fixed
    that" is almost always a deployment a few commits behind.
    """
    out = {"version": "unstamped", "commit": "?", "installed_at": "?", "drift": None}
    f = Path.home() / ".local/share/maintainer/VERSION"
    if f.exists():
        for line in f.read_text().splitlines():
            k, _, v = line.partition("=")
            out[k.strip()] = v.strip()
    src = out.get("installed_from")
    if src and Path(src, ".git").exists():
        head = subprocess.run(("git", "-C", src, "rev-parse", "--short", "HEAD"),
                              capture_output=True, text=True)
        if head.returncode == 0 and head.stdout.strip() != out.get("commit"):
            ahead = subprocess.run(("git", "-C", src, "rev-list", "--count",
                                    f"{out.get('commit')}..HEAD"),
                                   capture_output=True, text=True).stdout.strip()
            out["drift"] = (f"the checkout is at {head.stdout.strip()}, "
                            f"{ahead or 'some'} commit(s) ahead of what is installed")
    return out


def _profile_env(profile: str = PROFILE) -> dict:
    """Source the deployed profile.env and read its values back.

    Sourced rather than parsed, because the values are shell:
    `STATE_DIR="${MAINTAINER_STATE_DIR:-$HOME/.local/state/x-maint}"` cannot be
    read with a regex without reimplementing parameter expansion. run.sh sources
    the same file on every run, so this adds no new trust.
    """
    path = Path.home() / ".local/share/maintainer/profiles" / profile / "profile.env"
    out = {"_profile": profile, "_path": str(path)}
    if not path.exists():
        return out
    keys = ("REPO_PATH", "REPO_SLUG", "STATE_DIR", "TASKS", "POST", "GH_ACCOUNT",
            "MAINTAINER_NAME", "REQUIRED_COMMANDS")
    # The path goes in as an ARGUMENT, never interpolated into the script. The
    # key names are a literal tuple in this file, so they are the only thing
    # that reaches the command text.
    script = '. "$1" >/dev/null 2>&1; ' + "".join(
        f'printf "%s\\n" "${{{k}:-}}"; ' for k in keys)
    p = subprocess.run(("bash", "-c", script, "_", str(path)),
                       capture_output=True, text=True)
    if p.returncode != 0:
        return out
    values = p.stdout.split("\n")
    out.update({k: v for k, v in zip(keys, values)})
    # Every MIN_HOURS_<task>, for the "held back" marker in status.
    for task in (out.get("TASKS") or "").split():
        # TASKS comes from the file, so a task name reaches the command text.
        # Same rule as the profile name: a plain word or it is not used.
        if not _SAFE_NAME.match(task):
            continue
        q = subprocess.run(
            ("bash", "-c", f'. "$1" >/dev/null 2>&1; printf "%s" "${{MIN_HOURS_{task}:-}}"',
             "_", str(path)),
            capture_output=True, text=True)
        if q.returncode == 0 and q.stdout.strip():
            out[f"MIN_HOURS_{task}"] = q.stdout.strip()
    return out


_ENV = _profile_env()


def _setting(env_key: str, profile_key: str, default: str) -> str:
    return os.environ.get(env_key) or _ENV.get(profile_key) or default


# No fallback names a person or a repository. A tool that guesses which project
# it is acting on will eventually guess wrong, in public.
REPO = Path(_setting("MAINTAINER_REPO", "REPO_PATH", ""))
SLUG = _setting("MAINTAINER_SLUG", "REPO_SLUG", "")
ROOT = Path(_setting("MAINTAINER_STATE", "STATE_DIR",
                     str(Path.home() / ".local/state/maintainer")))
RUNS, STATE, DRAFTS = ROOT / "runs", ROOT / "state", ROOT / "drafts"
# The transcript filter writes the usage record beside the log, so the digest
# reads it from here rather than from the report, which is prose.
LOGS = ROOT / "logs"
INDEX = ROOT / "index.md"
# `start` writes this as the FIRST line and nowhere else, so `finish` anchors to
# line 1. It used to search the whole file, and on 2026-09-03 it threw away a
# finished 262-line report because the report quoted this string while writing
# up a finding about it. The run went unaudited, its baseline never promoted,
# and a critical desktop alert fired. Same shape as docs/lessons.md §5: a check
# must not match its own subject.
SENTINEL = "<!-- maintainer: report not yet written -->"
# A report opened by an older `start` carries the previous spelling on line 1.
SENTINELS = (SENTINEL, "<!-- sysknife-maint: report not yet written -->")
TASKS = _setting("MAINTAINER_TASKS", "TASKS", "review issues ci audit").split()
SKILL = os.environ.get("MAINTAINER_SKILL", "")


def skill_for(task: str) -> str:
    """The skill this task loads, or a plain statement that none is declared.

    There used to be a fallback map here keyed to one repository's skill names,
    so a second profile with no SKILL_<task> was told to load `sysknife-review`,
    a skill written for another project's gates. Inventing a skill name is worse
    than admitting there is none.
    """
    return SKILL or f"(none declared; set SKILL_{task} in profile.env)"



# Titles and login names are written by strangers and end up inside the prompt
# that drives an unattended agent. A title carrying a newline and a code fence
# escaped the context block and rendered as top-level instructions, which is the
# indirect-injection path this whole system is supposed to defend against.
# Collapse to one line, strip the fence characters, and cap the length.
def safe_for_prompt(text: str, limit: int = 90) -> str:
    flat = " ".join(str(text).split())
    flat = flat.replace("`", "'").replace("$", "").replace("\\", "/")
    return flat[:limit] + ("..." if len(flat) > limit else "")


def _spawn(args, **kw):
    """subprocess.run, but a missing binary is a sentence rather than a stack.

    `systemctl` was called by name with no guard and `maintainer status` died
    with an uncaught FileNotFoundError on any host without systemd, which is
    three of the four schedulers this project documents. git and gh are genuine
    requirements, so those still stop the command; they now say which binary is
    missing instead of printing thirteen lines of traceback at a user who has
    not installed gh yet.
    """
    try:
        return subprocess.run(args, capture_output=True, text=True, **kw)
    except FileNotFoundError:
        raise SystemExit(f"maintainer: {args[0]} is not installed, and this command needs it.\n"
                         f"            Install it and run this again.")


def run(*args: str, cwd: Path | None = REPO, check: bool = True) -> str:
    p = _spawn(args, cwd=cwd)
    if check and p.returncode != 0:
        raise SystemExit(f"maintainer: `{' '.join(args)}` failed ({p.returncode})\n"
                         f"{p.stderr.strip()}")
    return p.stdout.strip()


def gh_json(*args: str):
    """Query gh, degrading to None rather than aborting the run on a rate limit."""
    p = _spawn(("gh", *args), cwd=REPO)
    if p.returncode != 0:
        return None
    try:
        return json.loads(p.stdout)
    except json.JSONDecodeError:
        return None


def refresh() -> tuple[str, str, list[str], list[str]]:
    """Fast-forward main and fetch every open PR head. Returns (before, after, commits, notes)."""
    notes: list[str] = []
    dirty = run("git", "status", "--porcelain")
    if dirty:
        raise SystemExit(
            "maintainer: the working tree has uncommitted changes, so the refresh "
            "stopped rather than touching them.\n\n" + dirty +
            "\n\nCommit, stash or clean these by hand, then re-run.")

    before = run("git", "rev-parse", "HEAD")
    run("git", "fetch", "origin", "--prune", "--tags", "--quiet")

    head = run("git", "rev-parse", "--abbrev-ref", "HEAD")
    if head != "main":
        notes.append(f"was on `{head}`, returned to `main`")
        run("git", "checkout", "main", "--quiet")

    ahead = run("git", "rev-list", "--count", "origin/main..HEAD", check=False)
    if ahead.isdigit() and int(ahead) > 0:
        raise SystemExit(
            f"maintainer: local main is {ahead} commit(s) ahead of origin/main. A run "
            "must never leave commits behind; resolve by hand before the next pass.")

    merge = subprocess.run(("git", "merge", "--ff-only", "origin/main"),
                           cwd=REPO, capture_output=True, text=True)
    if merge.returncode != 0:
        raise SystemExit(
            "maintainer: `main` cannot fast-forward to origin/main, so local "
            "commits or a rewrite are in the way. Resolve by hand.\n" + merge.stderr.strip())

    after = run("git", "rev-parse", "HEAD")
    commits = []
    if before != after:
        rng = f"{before}..{after}"
        log = run("git", "log", "--oneline", "--no-decorate", rng, check=False)
        # Through the same filter as PR and issue titles. A squash-merge subject
        # is usually the pull request title, so the same attacker-controlled text
        # was filtered when read from the PR list and raw when read from the log.
        commits = [safe_for_prompt(ln, 120) for ln in log.splitlines() if ln]

    prs = gh_json("pr", "list", "--state", "open", "--limit", "100",
                  "--json", "number,headRefOid,updatedAt,title,author")
    if prs is None:
        notes.append("gh unavailable: PR heads not fetched, deltas below are git-only")
        prs = []
    for pr in prs:
        subprocess.run(("git", "fetch", "origin",
                        f"refs/pull/{pr['number']}/head:p{pr['number']}", "--force", "--quiet"),
                       cwd=REPO, capture_output=True, text=True)
    return before, after, commits, notes


def snapshot(main_sha: str) -> dict:
    prs = gh_json("pr", "list", "--state", "open", "--limit", "100",
                  "--json", "number,headRefOid,updatedAt,title,author") or []
    issues = gh_json("issue", "list", "--state", "open", "--limit", "200",
                     "--json", "number,updatedAt,title,labels") or []
    baseline = None
    art = REPO / "tests/evidence/workspace-tests.json"
    if art.exists():
        try:
            baseline = json.loads(art.read_text()).get("tests")
        except json.JSONDecodeError:
            pass
    return {
        "main_sha": main_sha,
        "captured_at": datetime.now(timezone.utc).isoformat(timespec="seconds"),
        "workspace_tests": baseline,
        "open_prs": {str(p["number"]): {"head": p["headRefOid"], "updated": p["updatedAt"],
                                        "title": safe_for_prompt(p["title"]), "author": safe_for_prompt(p["author"]["login"], 40)}
                     for p in prs},
        "open_issues": {str(i["number"]): {"updated": i["updatedAt"], "title": safe_for_prompt(i["title"]),
                                           "labels": sorted(l["name"] for l in i["labels"])}
                        for i in issues},
    }


def delta(old: dict | None, new: dict) -> list[str]:
    if old is None:
        return ["no previous run recorded for this skill; this run establishes the baseline"]
    out: list[str] = []
    # What has this task not reviewed? `refresh()` answers a different question,
    # "what did this run's fetch pull in", and prints "(already current)" when
    # the answer is nothing. A commit made on this machine between two runs
    # arrives without a fetch, so a whole commit went unmentioned and a run was
    # told the tree was current. snapshot() has always written main_sha and
    # nothing read it.
    old_sha, new_sha = old.get("main_sha"), new.get("main_sha")
    if old_sha and new_sha and old_sha != new_sha:
        log = subprocess.run(("git", "log", "--oneline", "--no-decorate",
                              f"{old_sha}..{new_sha}"),
                             cwd=REPO, capture_output=True, text=True)
        commits = [ln for ln in log.stdout.splitlines() if ln] if log.returncode == 0 else []
        out.append(f"main moved {old_sha[:8]} -> {new_sha[:8]} since this task last ran"
                   + (f", {len(commits)} commit(s) YOU HAVE NOT REVIEWED:" if commits else ""))
        out.extend(f"    {c}" for c in commits[:20])
        if len(commits) > 20:
            out.append(f"    ... and {len(commits) - 20} more")
    elif old_sha and new_sha:
        out.append(f"main is unchanged since this task last ran ({new_sha[:8]})")
    op, np_ = old.get("open_prs", {}), new["open_prs"]
    for n in sorted(set(np_) - set(op), key=int):
        out.append(f"PR #{n} opened by {np_[n]['author']}: {np_[n]['title']}")
    for n in sorted(set(op) - set(np_), key=int):
        out.append(f"PR #{n} closed or merged since last run: {op[n]['title']}")
    for n in sorted(set(op) & set(np_), key=int):
        if op[n]["head"] != np_[n]["head"]:
            out.append(f"PR #{n} head moved {op[n]['head'][:8]} -> {np_[n]['head'][:8]} "
                       f"(re-review at the new SHA)")
    oi, ni = old.get("open_issues", {}), new["open_issues"]
    new_i = sorted(set(ni) - set(oi), key=int)
    closed_i = sorted(set(oi) - set(ni), key=int)
    touched = [n for n in sorted(set(oi) & set(ni), key=int) if oi[n]["updated"] != ni[n]["updated"]]
    if new_i:
        out.append("issues opened: " + ", ".join("#" + n for n in new_i))
    if closed_i:
        out.append("issues closed: " + ", ".join("#" + n for n in closed_i))
    if touched:
        out.append("issues with new activity: " + ", ".join("#" + n for n in touched))
    if old.get("workspace_tests") != new.get("workspace_tests"):
        out.append(f"workspace test baseline {old.get('workspace_tests')} -> {new.get('workspace_tests')}")
    return out or ["nothing changed on the tracker since the last run of this skill"]



# ---------------------------------------------------------------------------
# Untrusted-code screen
# ---------------------------------------------------------------------------
# `cargo test` on a fork PR executes that contributor's code, and `build.rs`
# executes it at compile time, as this user. Mount isolation is unavailable on
# this host, so the containment is to not run the code at all when the diff can
# reach a compiler or the network.

# Paths whose change means the PR can execute code during a build, or can change
# what CI itself runs. Building one of these unsandboxed is remote code
# execution with the maintainer's own credentials on disk.
EXECUTES_ON_BUILD = (
    ("build.rs", "runs at compile time, before any test"),
    (".cargo/config.toml", "can redirect the registry or inject rustflags"),
    (".cargo/config", "can redirect the registry or inject rustflags"),
    ("Cargo.lock", "a dependency change pulls and builds new third-party code"),
    ("rust-toolchain", "selects the toolchain that will be executed"),
    ("rust-toolchain.toml", "selects the toolchain that will be executed"),
    (".github/workflows/", "changes what CI runs, and gates run approval"),
    ("Makefile", "arbitrary recipes"),
    ("justfile", "arbitrary recipes"),
    ("xtask/", "a build-system crate that runs as part of normal commands"),
)
# Anything the repo's own gates EXECUTE. The first version of this screen only
# looked for build-time vectors, so a PR adding one integration test came back
# SAFE TO BUILD and `cargo nextest run --workspace` then ran that test. The
# execution surface is the union of build time and test time, and test time is
# the normal path for every Rust change here.
EXECUTED_BY_GATES = (
    (".rs", "cargo test compiles and runs it"),
    (".sh", "the shellcheck and hygiene gates execute these directly"),
    (".py", "scripts/ are run by docs-and-hygiene"),
    (".js", "npm test --prefix packages/setup runs it"),
    (".mjs", "npm test --prefix packages/setup runs it"),
    (".ts", "the frontend job runs it"),
)
DEP_SECTIONS = ("[dependencies]", "[build-dependencies]", "[dev-dependencies]")
# Only these are inert: read as text by a gate, never executed.
INERT_SUFFIXES = (".md", ".json", ".yml", ".yaml", ".txt", ".lock.example", ".svg", ".png")


def _sh(*args: str) -> tuple[int, str]:
    p = _spawn(args, cwd=REPO)
    return p.returncode, p.stdout


def cmd_abort(run_id: str, reason: str) -> None:
    """Record that a run started and produced nothing.

    A run that dies between its first log line and its report used to leave the
    index with a gap in it, and a gap is indistinguishable from a run that never
    started. `2026-09-03T07-52-review` is the case: a 22-line log holding the
    task briefing and nothing else, no report, no index line, while fifteen
    comments went out under the same account in the hour that followed. Reading
    the index, that run did not happen.

    The index is the document a reader trusts, so it is the one that has to say
    so.
    """
    INDEX.parent.mkdir(parents=True, exist_ok=True)
    if INDEX.exists() and f"`{run_id}`" in INDEX.read_text():
        return
    with INDEX.open("a") as fh:
        fh.write(f"- `{run_id}`  {datetime.now().strftime('%Y-%m-%d %H:%M')}  "
                 f"**ABORTED**, no report  ({safe_for_prompt(reason, 100)})\n")
    print(f"maintainer: recorded {run_id} as ABORTED in {INDEX}")


# A report is a claim. `<run>.commands` is the record. Nothing compared them.
#
# docs/lessons.md 12: a review report read `sysknife-maint screen 348 -> DO NOT
# EXECUTE` for a command that had been renamed and no longer existed on PATH.
# Either the agent ran the real one and copied a dead name out of the prompt, or
# it ran nothing and wrote a plausible verdict. The trail could not tell those
# apart. It can now, and until this nothing looked.
#
# Extraction is the part that needs care, and the reason this warns rather than
# refuses. A report quotes four different kinds of command: ones the agent ran,
# ones it recommends to a human, ones a contributor should run, and ones inside
# a diff it is reviewing. Only the first is a claim. The convention that
# separates them here is the `$ ` prefix inside a fenced block, which is what
# these reports use for "I ran this" and what scripts/transcript.py writes for
# a Bash tool call, so the two sides are comparable by construction.
#
# Refusing would lose a whole run over wording. A report that paraphrases a
# command it did run is sloppy; one that quotes a command nothing executed is
# the defect, and only a reader can tell which.
def claimed_commands(report_text: str) -> list[str]:
    out, fenced = [], False
    for ln in report_text.splitlines():
        if ln.lstrip().startswith("```"):
            fenced = not fenced
            continue
        if not fenced:
            continue
        st = ln.strip()
        if st.startswith("$ ") and len(st) > 2:
            out.append(" ".join(st[2:].split()))
    return out


def _claim_in(claim: str, record: str) -> bool:
    """Is this quoted command in the record, allowing for how reports quote.

    Measured against a real report before this existed: 2 of 13 quoted commands
    read as missing and both were artefacts of quoting, not of lying.

      - `gh run list ... --json databaseId,status,... \\` : the report wrote an
        ellipsis where the flags went. The command is in the record in full.
      - `bash /tmp/fakerepo/tests/e2e/story-metadata.test.sh` : a line from
        inside a harness script the agent wrote and ran. The record holds the
        outer invocation, not each line the script then executed.

    So: a claim carrying an explicit `...` is compared on the part before it,
    because the author already said it was abridged, and a long claim matches on
    a generous prefix. Both weaken the check, and the check is a warning whose
    only job is to put a human's eye on the right line.
    """
    if claim in record:
        return True
    head = claim.split("...", 1)[0].strip() if "..." in claim else claim
    if len(head) >= 12 and head in record:
        return True
    return len(claim) > 40 and claim[:40] in record


def audit_run(run_id: str) -> tuple[str, list[str], int]:
    """-> (verdict, unmatched claims, number of claims checked)."""
    report = RUNS / f"{run_id}.md"
    if not report.exists():
        return "NO REPORT", [], 0
    cmds = LOGS / f"{_log_stem(run_id)}.commands"
    if not cmds.exists():
        return "no command record: nothing to compare against", [], 0
    record = cmds.read_text()
    # Normalised on both sides. The record stores a Bash call as `$ <command>`
    # with the agent's own whitespace, and a report re-wraps it.
    flat = " ".join(record.split())
    claims = claimed_commands(report.read_text())
    if not claims:
        return "the report quotes no executed command", [], 0
    missing = [c for c in claims if not _claim_in(c, flat)]
    if missing:
        return f"{len(missing)} of {len(claims)} quoted command(s) are not in the record", missing, len(claims)
    return f"all {len(claims)} quoted command(s) appear in the record", [], len(claims)


def cmd_audit(which: str) -> None:
    ids = ([p.stem for p in sorted(RUNS.glob("*.md"))] if which in ("--all", "")
           else [which])
    if not ids:
        print("maintainer: no runs to audit")
        return
    worst = 0
    for rid in ids:
        verdict, missing, n = audit_run(rid)
        flag = " "
        if verdict.startswith("NO REPORT") or "are not in the record" in verdict:
            flag, worst = "!", 1
        elif "no command record" in verdict:
            flag = "?"
        print(f"{flag} {rid:26} {verdict}")
        for m in missing:
            print(f"      claimed, never run:  {safe_for_prompt(m, 100)}")
    if worst:
        print("\n! a report quotes a command the transcript does not contain. That is")
        print("  sloppy wording or a claim nothing executed, and only reading it tells")
        print("  you which.")
    print("? no command record exists for that run, so nothing could be compared.")


def cmd_gc(dry: bool) -> None:
    """Prune logs and drafts past the retention window. Never runs/ or index.md.

    A state directory that only grows is how a tool becomes something people
    delete rather than something they keep. Four tasks over a year is on the
    order of a thousand runs, each leaving a log, a command record, a usage
    record and a drafts directory.

    What is kept forever, deliberately: `runs/` and `index.md`. Those are the
    record of what this agent published in somebody's name, and `install.sh
    --uninstall` already refuses to delete them. A retention policy that can
    erase the evidence of a post is not a retention policy.
    """
    days = _ENV.get("RETENTION_DAYS", "").strip()
    days = int(days) if days.isdigit() else 90
    cutoff = datetime.now().timestamp() - days * 86400
    freed, kept, n = 0, 0, 0
    for base in (LOGS, DRAFTS):
        if not base.exists():
            continue
        for entry in sorted(base.iterdir()):
            try:
                mtime = entry.stat().st_mtime
            except OSError:
                continue
            size = sum(f.stat().st_size for f in entry.rglob("*") if f.is_file()) \
                if entry.is_dir() else entry.stat().st_size
            if mtime >= cutoff:
                kept += size
                continue
            n += 1
            freed += size
            if dry:
                print(f"  would remove  {entry.relative_to(ROOT)}  ({size} bytes)")
            else:
                if entry.is_dir():
                    shutil.rmtree(entry, ignore_errors=True)
                else:
                    entry.unlink(missing_ok=True)
                print(f"  removed  {entry.relative_to(ROOT)}  ({size} bytes)")
    verb = "would free" if dry else "freed"
    print(f"maintainer: {verb} {freed} bytes across {n} item(s) older than {days} days; "
          f"{kept} bytes kept")
    print(f"            runs/ and index.md are never pruned: they record what was "
          f"published in your name")


def cmd_screen(pr: str) -> None:
    """Say whether a PR may be executed on the host, and why not when it may not.

    Fails closed. Every path that cannot establish the answer raises rather than
    printing a permissive verdict, because a screen that errs toward SAFE is
    worse than no screen: it launders an unknown into a reassurance.
    """
    meta = gh_json("pr", "view", pr, "--json", "files,headRefOid,author,title,changedFiles")
    if meta is None:
        raise SystemExit(f"maintainer: could not read PR {pr} from gh; screen FAILED, treat as READ-ONLY")
    paths = [f["path"] for f in meta.get("files", [])]
    declared = meta.get("changedFiles", len(paths))
    truncated = declared > len(paths)

    blocks: list[tuple[str, str]] = []
    for path in paths:
        for marker, why in EXECUTES_ON_BUILD:
            if path == marker or path.endswith("/" + marker) or (marker.endswith("/") and marker in path):
                blocks.append((path, f"build-time: {why}"))
        for suffix, why in EXECUTED_BY_GATES:
            if path.endswith(suffix):
                blocks.append((path, f"test-time: {why}"))

    rc, diff = _sh("gh", "pr", "diff", pr, "--patch")
    if rc != 0:
        raise SystemExit(f"maintainer: could not read the diff for PR {pr}; screen FAILED, treat as READ-ONLY")
    for path in (p for p in paths if p.endswith("Cargo.toml")):
        hunk, in_file = [], False
        for line in diff.splitlines():
            if line.startswith("diff --git"):
                in_file = path in line
            elif in_file and line[:1] in "+-" and not line.startswith(("+++", "---")):
                hunk.append(line)
        if any(s in "\n".join(hunk) for s in DEP_SECTIONS) or any(
            k in l for l in hunk if l.startswith("+") for k in ("git =", "path =", "version =")
        ):
            blocks.append((path, "build-time: dependency lines changed, new third-party code would be built"))

    title = safe_for_prompt(meta.get("title", ""))
    print(f"=== screen: PR {pr} — {title}")
    print(f"author {meta['author']['login']}  head {meta['headRefOid'][:8]}  files {len(paths)} of {declared}")
    if truncated:
        blocks.append(("<file list truncated>",
                       f"gh returned {len(paths)} of {declared} files, so the rest were never screened"))

    if blocks:
        seen, ordered = set(), []
        for item in blocks:
            if item not in seen:
                seen.add(item)
                ordered.append(item)
        print("\nVERDICT: DO NOT EXECUTE. Review this PR by reading the diff.")
        for path, why in ordered[:12]:
            print(f"  - {path}: {why}")
        if len(ordered) > 12:
            print(f"  ... and {len(ordered) - 12} more")
        print("\nIn an unattended run there is no fallback: do not build, do not test,")
        print("do not run its scripts. Say in the review that you reviewed by reading.")
        print("Interactively, you can execute it in podman:")
        print("  podman run --rm --network=none -v \"$PWD:/repo:ro\" docker.io/library/rust:1-slim \\")
        print("    sh -c 'cd /repo && cargo test --offline'")
        if any(".github/workflows/" in p for p, _ in ordered):
            print("\nThis PR touches .github/workflows/. Do NOT approve its queued workflow")
            print("run: that approval is the control that stops a fork's code running in CI.")
    else:
        inert = [p for p in paths if p.endswith(INERT_SUFFIXES)]
        if len(inert) != len(paths):
            raise SystemExit(
                "maintainer: screen could not classify "
                f"{sorted(set(paths) - set(inert))}; failing closed, treat as DO NOT EXECUTE")
        print("\nVERDICT: INERT. Every changed file is read as text by a gate and never")
        print("executed. Building is unnecessary rather than merely permitted.")


def cmd_start(skill: str) -> None:
    # A hyphen in a task name breaks two things quietly: run.sh builds
    # MODEL_$task as a shell variable name, and cmd_finish recovers the task
    # from the run id by taking the text after the last hyphen. Refuse at the
    # boundary rather than let the baseline silently never promote.
    if "-" in skill:
        raise SystemExit(f"maintainer: task names cannot contain a hyphen ({skill!r}): "
                         "run.sh builds MODEL_<task> as a shell variable name")
    if skill not in TASKS:
        raise SystemExit(f"maintainer: unknown task {skill!r}; this profile runs {', '.join(TASKS)}")
    # An empty command record, created up front. Without this a run that died
    # before the backend produced anything leaves no .commands file at all, and
    # "the transcript recorded nothing" reads identically to "no transcript was
    # ever kept". Seven of this project's first nine runs are the second kind
    # and cannot now be told apart from the first.
    LOGS.mkdir(parents=True, exist_ok=True)
    for d in (RUNS, STATE, DRAFTS):
        d.mkdir(parents=True, exist_ok=True)

    stamp = datetime.now().strftime("%Y-%m-%dT%H-%M")
    run_id = f"{stamp}-{skill}"
    # Two runs in the same minute must not share a report path, or the second
    # silently overwrites the first and one run leaves no trace.
    suffix = 1
    while (RUNS / f"{run_id}.md").exists():
        suffix += 1
        run_id = f"{stamp}-{skill}.{suffix}"
    (LOGS / f"{_log_stem(run_id)}.commands").touch(exist_ok=True)
    before, after, commits, notes = refresh()

    state_file = STATE / f"last-{skill}.json"
    previous = json.loads(state_file.read_text()) if state_file.exists() else None
    snap = snapshot(after)
    changes = delta(previous, snap)

    report = RUNS / f"{run_id}.md"
    # Reserve the path immediately. The collision loop above can only work if the
    # file exists between `start` and the agent writing it, and the sentinel is
    # what stops `finish` from accepting the placeholder as a real report.
    report.write_text(f"{SENTINEL}\n# {run_id}\n")
    draft_dir = DRAFTS / run_id
    draft_dir.mkdir(parents=True, exist_ok=True)

    snap["run_id"] = run_id
    snap["previous_run"] = (previous or {}).get("run_id")
    # Written as *pending*, and promoted to the baseline only by `finish`. A run
    # that dies must not move the baseline: the next run would diff against
    # changes nobody actually reviewed and skip them as already seen. Found by
    # the 2026-09-02T14-36-review run, which noticed a state file newer than any
    # report.
    (STATE / f"pending-{skill}.json").write_text(json.dumps(snap, indent=2, sort_keys=True) + "\n")

    print(f"=== maintainer {run_id} ===")
    print(f"skill        {skill_for(skill)}")
    print(f"repo         {REPO}")
    print(f"main         {before[:8]} -> {after[:8]}" + ("  (already current)" if before == after else ""))
    if commits:
        print(f"new commits  {len(commits)}")
        for c in commits[:20]:
            print(f"  {c}")
    for n in notes:
        print(f"note         {n}")
    prev_id = (previous or {}).get("run_id", "none")
    print(f"\nsince the last `{skill}` run ({prev_id}):")
    for c in changes:
        print(f"  - {c}")
    print(f"\nwrite the run report to  {report}")
    print(f"put any drafts under     {draft_dir}/")
    print("run.sh closes the run for you; do not call `maintainer finish` yourself")


def cmd_finish(run_id: str) -> None:
    report = RUNS / f"{run_id}.md"
    INDEX.parent.mkdir(parents=True, exist_ok=True)
    if not report.exists() or not report.read_text().strip():
        raise SystemExit(
            f"maintainer: {report} is missing or empty. A run with no report is not "
            f"auditable; write the report, then finish.")
    first = report.read_text().splitlines()[0] if report.read_text().splitlines() else ""
    if any(sent in first for sent in SENTINELS):
        raise SystemExit(
            f"maintainer: {report} still opens with the placeholder line, so the run "
            f"wrote no report. Replace the whole file, then finish.")
    # A fixture is not a report. `runs/2026-09-02T14-39-review.md` in this
    # project's own trail reads, in full, "# <run id>" and "baseline promotion
    # test": something typed by hand while testing baseline promotion, indexed
    # in the same format as every genuine run, with a working link. The
    # sentinel check above exists for exactly this and its list only covers the
    # placeholder the tooling writes.
    #
    # The bar is deliberately low. A real report has a heading and some prose;
    # anything under it was not written by a run that did work.
    body = [ln for ln in report.read_text().splitlines()[1:] if ln.strip()]
    if len(body) < 3:
        raise SystemExit(
            f"maintainer: {report} has {len(body)} non-empty line(s) below its heading, "
            f"which is a fixture rather than a report. It is NOT being indexed.\n"
            f"            If a run genuinely found nothing, say that in three lines: what "
            f"you looked at, what you found, and what you decided not to do.")
    # Idempotent: both the agent and run.sh call this, and a run counted twice is
    # a wrong audit trail just as surely as a run counted zero times.
    if INDEX.exists() and f"`{run_id}`" in INDEX.read_text():
        print(f"maintainer: {run_id} already recorded, nothing to do")
        return
    line = (f"- `{run_id}`  {datetime.now().strftime('%Y-%m-%d %H:%M')}  "
            f"{len(report.read_text().splitlines())} lines  [{report.name}](runs/{report.name})\n")
    with INDEX.open("a") as fh:
        fh.write(line)
    skill = run_id.split("-")[-1].split(".")[0]
    pending = STATE / f"pending-{skill}.json"
    if pending.exists():
        # A corrupt pending file used to raise here, AFTER the run was written
        # into the index, so run.sh reported "produced no report; the run is not
        # auditable" about a run whose report existed and was indexed. Name the
        # actual fault instead.
        try:
            same = json.loads(pending.read_text()).get("run_id") == run_id
        except json.JSONDecodeError:
            print(f"maintainer: {pending} is corrupt, so the baseline was NOT promoted. "
                  f"The report is written and indexed. Delete or repair that file; "
                  f"the next run will re-review everything since the last good baseline.")
            return
        if same:
            (STATE / f"last-{skill}.json").write_text(pending.read_text())
            pending.unlink()
    # The run got all the way here, so whatever this task failed with last time
    # is resolved. Only this task's marker: a review succeeding says nothing
    # about the ci sweep.
    clear_failure(skill)
    print(f"maintainer: recorded {run_id} in {INDEX}")


def _next_runs(profile: str) -> dict:
    """Ask the scheduler when each task fires next. Absent one, say so.

    systemd is one of four documented schedulers, and this asked for it by name
    with no guard. On any host without it -- macOS, Windows, a container --
    `maintainer status` printed three lines and then died with an uncaught
    FileNotFoundError. Found by running the test suite inside python:3.12.
    """
    try:
        p = subprocess.run(("systemctl", "--user", "list-timers", f"maintainer@{profile}-*",
                            "--all", "--no-pager", "--output=json"),
                           capture_output=True, text=True)
    except (FileNotFoundError, PermissionError, OSError):
        return {}
    if p.returncode != 0:
        return {}
    try:
        rows = json.loads(p.stdout)
    except json.JSONDecodeError:
        return {}
    out = {}
    for r in rows:
        unit = r.get("unit", "")
        if "-" not in unit:
            continue
        task = unit.rsplit("-", 1)[-1].split(".")[0]
        # In systemctl's JSON output `left` is not a remainder: it carries the
        # same absolute microsecond timestamp as `next`. Printing it as a
        # duration put "in 20700 days" in the column. Subtract now.
        nxt = r.get("next")
        out[task] = (_duration(nxt / 1e6 - datetime.now().timestamp())
                     if isinstance(nxt, (int, float)) and nxt > 0 else "-")
    return out


def _duration(sec: float) -> str:
    if sec < 0:
        return "overdue"
    if sec < 3600:
        return f"in {sec / 60:.0f}m"
    if sec < 86400:
        return f"in {sec / 3600:.0f}h"
    return f"in {sec / 86400:.1f}d"


# ---------------------------------------------------------------- failures
#
# The layer that cannot fail. A run that dies at 03:00 reaches its owner
# through notify-send, which guesses a display, guesses a D-Bus address, and
# ends in `|| true`. On a headless box, on Wayland without XWayland, on a
# session that is not :1, or while nobody is logged in -- which is the case
# `loginctl enable-linger` exists to create -- that alert goes nowhere and says
# nothing about having gone nowhere. A timer could fail every night for a week
# and leave only a log nobody opened.
#
# So the marker is written to disk first, and every other channel is a bonus.
def failure_marker(task: str) -> Path:
    return STATE / f"failed-{task}.json"


def record_failure(task: str, reason: str, log: str = "") -> None:
    STATE.mkdir(parents=True, exist_ok=True)
    failure_marker(task).write_text(json.dumps({
        "task": task, "reason": reason, "log": log,
        "at": datetime.now().astimezone().isoformat(),
    }, indent=2) + "\n")


def clear_failure(task: str) -> None:
    failure_marker(task).unlink(missing_ok=True)


def open_failures() -> list[dict]:
    out = []
    for f in sorted(STATE.glob("failed-*.json")):
        try:
            out.append(json.loads(f.read_text()))
        except (json.JSONDecodeError, OSError):
            out.append({"task": f.stem.replace("failed-", ""),
                        "reason": "unreadable failure marker", "at": "?", "log": str(f)})
    return out


def cmd_status() -> None:
    ver = deployed_version()
    print(f"maintainer {ver['version']}  ({ver['commit']}, installed {ver.get('installed_at','?')[:16]})")
    if ver["version"] == "unstamped":
        print("  no version stamp on this deployment; re-run ./install.sh")
    if ver["drift"]:
        print(f"  \033[33mthis is NOT the code you are editing:\033[0m {ver['drift']}")
        print("  run ./install.sh to deploy it")
    print()
    # Before anything else. A failure is the one thing a person needs to see
    # without having been told to look for it.
    fails = open_failures()
    for f in fails:
        print(f"  \033[31mFAILED\033[0m  {f.get('task','?')} at {str(f.get('at',''))[:16]}: "
              f"{f.get('reason','?')}")
        if f.get("log"):
            print(f"          log  {f['log']}")
    if fails:
        print(f"  {len(fails)} unresolved failure(s). The next successful run of a task clears its own.")
        print()
    env = _ENV
    # _profile_env sources the file, so this is the evaluated value. A profile
    # that fails to source yields "", and the safe reading of an unknown state
    # is that the agent might post: say so rather than implying a rehearsal.
    post = (env.get("POST") or "").strip()
    if not post:
        post = "unknown (profile.env did not source; assume it can post)"
    print(f"profile   {env['_profile']}  ->  {SLUG}")
    print(f"repo      {REPO}")
    print("posting   " + ("OFF, rehearsal: it writes reports and drafts, and posts nothing"
                          if post == "off" else
                          "ON, this agent writes to GitHub in your name"
                          if post == "on" else post))
    if not (Path.home() / ".local/share/maintainer").exists():
        print("\nnot installed. Run ./install.sh from the repository.")
        return

    nxt = _next_runs(env["_profile"])
    held = False
    print()
    print(f"{'task':10} {'last run':22} {'age':>6}  {'report':>10}  {'spend':>7}  next")
    for task in TASKS:
        f = STATE / f"last-{task}.json"
        if f.exists():
            age_h = (datetime.now().timestamp() - f.stat().st_mtime) / 3600
            try:
                rid = json.loads(f.read_text()).get("run_id", "?")
            except json.JSONDecodeError:
                rid = "unreadable"
            report = RUNS / f"{rid}.md"
            lines = f"{len(report.read_text().splitlines())} lines" if report.exists() else "MISSING"
            age = f"{age_h:.0f}h"
            min_h = env.get(f"MIN_HOURS_{task}", "")
            if min_h.isdigit() and age_h < int(min_h):
                age += "*"
                held = True
        else:
            rid, age, lines = "never", "-", "-"
        # An unknown cost prints as "?" rather than as "$0.00". A run whose
        # spend was never recorded and a run that cost nothing are different
        # facts, and every run before scripts/transcript.py existed is the first
        # kind.
        c = load_usage(rid).get("cost_usd_estimate") if rid not in ("never", "unreadable") else None
        spend = f"~${c:.2f}" if isinstance(c, (int, float)) else ("?" if rid != "never" else "-")
        print(f"{task:10} {rid:22} {age:>6}  {lines:>10}  {spend:>7}  {nxt.get(task, '-')}")
    if held:
        print("\n* inside its minimum interval; the next scheduled run skips and says so")

    # What this profile has spent, over every run that recorded it. Estimates,
    # summed, and labelled as such: the figure comes from Claude Code's own
    # bundled price table, not from a bill.
    costs = []
    for f in sorted(LOGS.glob("*.usage.json")):
        try:
            c = json.loads(f.read_text()).get("cost_usd_estimate")
        except (json.JSONDecodeError, OSError):
            continue
        if isinstance(c, (int, float)):
            costs.append(c)
    total_runs = len(INDEX.read_text().splitlines()) if INDEX.exists() else 0
    if costs:
        print(f"\nspend  ~${sum(costs):.2f} over {len(costs)} of {total_runs} recorded run(s),"
              f" mean ~${sum(costs) / len(costs):.2f}")
        if len(costs) < total_runs:
            print(f"       {total_runs - len(costs)} run(s) have no usage record and are not in that"
                  " total")
        print("       Claude Code's own estimate from a bundled price table, not a bill")
    elif total_runs:
        print(f"\nspend  unknown: none of {total_runs} recorded run(s) has a usage record")

    pend = sorted(STATE.glob("pending-*.json"))
    if pend:
        print(f"\n{len(pend)} run(s) started and never finished: "
              + ", ".join(p.stem.replace("pending-", "") for p in pend))
        print("  a run that died leaves its baseline unpromoted on purpose, so the")
        print("  next run still sees everything it never reviewed")
    rec = sorted((ROOT / "receipts").glob("*.json")) if (ROOT / "receipts").exists() else []
    if rec:
        print(f"\n{len(rec)} verification receipt(s) open: "
              + ", ".join("#" + p.stem for p in rec))


def cmd_run(args: list[str]) -> None:
    """Run one task now, through the deployed orchestrator.

    A wrapper over ~/.local/share/maintainer/run.sh, because the path to it is
    the one thing a new maintainer has to be told twice. The cadence gate still
    applies; MAINTAINER_FORCE=1 overrides it.
    """
    profile = os.environ.get("MAINTAINER_PROFILE", "sysknife")
    runsh = Path.home() / ".local/share/maintainer/run.sh"
    if not runsh.exists():
        raise SystemExit(f"maintainer: {runsh} not found. Run ./install.sh from the repository.")
    show = [a for a in args if a == "--show-prompt"]
    rest = [a for a in args if a != "--show-prompt"]
    if len(rest) != 1:
        raise SystemExit("usage: maintainer run [--show-prompt] <task>")
    os.execv("/bin/bash", ["bash", str(runsh), *show, profile, rest[0]])


def cmd_log(n: int) -> None:
    if not INDEX.exists():
        print("maintainer: no runs recorded yet")
        return
    lines = INDEX.read_text().splitlines()
    print("\n".join(lines[-n:]))



def _fmt_tokens(n: int) -> str:
    """Thousands and millions, because 9852000 is not a number anyone reads."""
    if not isinstance(n, (int, float)):
        return "?"
    if n >= 1_000_000:
        return f"{n / 1_000_000:.1f}M"
    if n >= 1_000:
        return f"{n / 1_000:.0f}k"
    return str(int(n))


def _fmt_ms(ms) -> str:
    if not isinstance(ms, (int, float)) or ms <= 0:
        return "?"
    s = ms / 1000
    if s < 90:
        return f"{s:.0f}s"
    if s < 5400:
        return f"{s / 60:.0f}m"
    return f"{s / 3600:.1f}h"


def load_usage(run_id: str) -> dict:
    """What the run spent, written by scripts/transcript.py beside the log.

    Absent for any run older than the transcript filter, and absent whenever a
    run died before the model returned a result. Both read as "unknown", never
    as zero: a run whose cost is unknown and a run that cost nothing are
    different facts and this used to print the same thing for both.
    """
    f = LOGS / f"{_log_stem(run_id)}.usage.json"
    if not f.exists():
        return {}
    try:
        return json.loads(f.read_text())
    except (json.JSONDecodeError, OSError):
        return {}


def _log_stem(run_id: str) -> str:
    """The log/commands/usage basename for a run id.

    A second run inside the same minute gets `<stamp>-<task>.2` as its run id
    while run.sh keeps writing `<stamp>-<task>.log`, so the suffix comes off.

    Named exactly, never globbed. The first version of this took the NEWEST
    matching file, which attributed one run's command count to another and
    printed "78 commands run" under a run that had executed none. That is
    docs/lessons.md 30 for the third time: a per-thing lookup with a wildcard
    reports on whoever answers first.
    """
    stem = run_id
    if "." in stem and stem.rsplit(".", 1)[1].isdigit():
        stem = stem.rsplit(".", 1)[0]
    return stem


def digest_lines(run_id: str, compact: bool = False) -> list[str]:
    """The run, in three lines, for a notification or a terminal.

    Deliberately made of things that were MEASURED. An earlier sketch of this
    parsed the report's prose for "3 PRs reviewed", which is the agent's claim
    about itself dressed up as a summary. Line count, command count, turns and
    spend all come from files the run wrote as it went.
    """
    report = RUNS / f"{run_id}.md"
    u = load_usage(run_id)
    t = u.get("totals", {})
    cost = u.get("cost_usd_estimate")
    sub = u.get("subtype")

    head = f"{PROFILE} {run_id.split('-')[-1]}"
    if u:
        head += f" · {'failed' if u.get('is_error') else 'done'} in {_fmt_ms(u.get('duration_ms'))}"
        if u.get("num_turns"):
            head += f" · {u['num_turns']} turns"
    lines = [head]

    if report.exists():
        n = len(report.read_text().splitlines())
        cmds = LOGS / f"{_log_stem(run_id)}.commands"
        ncmd = len(cmds.read_text().splitlines()) if cmds.exists() else None
        lines.append(f"report {n} lines" + (
            f" · {ncmd} commands run" if ncmd is not None
            else " · command record missing"))
    else:
        lines.append("NO REPORT: the run is not auditable")

    if u:
        spend = "~$?" if not isinstance(cost, (int, float)) else f"~${cost:.2f}"
        lines.append(f"{spend} est · out {_fmt_tokens(t.get('output_tokens'))}"
                     f" · cache read {_fmt_tokens(t.get('cache_read_input_tokens'))}"
                     f" · new cache {_fmt_tokens(t.get('cache_creation_input_tokens'))}")
    else:
        lines.append("spend unknown: no usage record for this run")

    if compact:
        return lines
    if u.get("by_model"):
        lines.append("")
        for name, m in u["by_model"].items():
            c = m.get("cost_usd_estimate")
            lines.append(f"  {name:24} ~${c:.2f}" if isinstance(c, (int, float))
                         else f"  {name:24} ~$?")
    lines += [
        "",
        "  The dollar figure is Claude Code's own client-side estimate from a",
        "  bundled price table. It is for budgeting, not billing.",
    ]
    if sub and sub != "success":
        lines.append(f"  The model returned subtype '{sub}', so this run did not finish cleanly.")
    return lines


def cmd_digest(run_id: str, compact: bool) -> None:
    print("\n".join(digest_lines(run_id, compact)))


def main() -> None:
    if len(sys.argv) < 2:
        raise SystemExit(__doc__)
    cmd = sys.argv[1]
    if cmd == "version":
        v = deployed_version()
        for k in ("version", "commit", "installed_at", "installed_from"):
            print(f"{k:15} {v.get(k, '?')}")
        if v["drift"]:
            print(f"{'drift':15} {v['drift']}")
        raise SystemExit(1 if v["version"] == "unstamped" else 0)
    elif cmd == "status":
        cmd_status()
    elif cmd == "run":
        cmd_run(sys.argv[2:])
    elif cmd == "start" and len(sys.argv) == 3:
        cmd_start(sys.argv[2])
    elif cmd == "finish" and len(sys.argv) == 3:
        cmd_finish(sys.argv[2])
    elif cmd == "screen" and len(sys.argv) == 3:
        cmd_screen(sys.argv[2])
    elif cmd == "gc":
        cmd_gc("--dry-run" in sys.argv[2:])
    elif cmd == "audit":
        cmd_audit(sys.argv[2] if len(sys.argv) > 2 else "--all")
    elif cmd == "abort" and len(sys.argv) >= 4:
        cmd_abort(sys.argv[2], sys.argv[3])
    elif cmd == "failed" and len(sys.argv) >= 4:
        record_failure(sys.argv[2], sys.argv[3], sys.argv[4] if len(sys.argv) > 4 else "")
    elif cmd == "ok" and len(sys.argv) == 3:
        clear_failure(sys.argv[2])
    elif cmd == "digest" and len(sys.argv) >= 3:
        cmd_digest(sys.argv[2], "--compact" in sys.argv[3:])
    elif cmd == "log":
        cmd_log(int(sys.argv[2]) if len(sys.argv) > 2 else 10)
    else:
        raise SystemExit(__doc__)


if __name__ == "__main__":
    main()
