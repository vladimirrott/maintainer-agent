#!/usr/bin/env bash
# Repository housekeeping a maintainer does after every merge, and a release
# check that says whether one is owed.
#
#   maintainer-repo prune [--dry-run]    delete merged branches, local and remote
#   maintainer-repo release-check        is a release due, and what digit moves
#
# Both exist because they are the chores a solo maintainer stops doing first,
# and both are cheap to get wrong by hand: a branch deleted while a PR is still
# open, or a security fix left sitting unreleased on main.
set -uo pipefail

REPO_SLUG="${MAINTAINER_SLUG:-lacs-project/sysknife}"
REPO_PATH="${MAINTAINER_REPO:-$HOME/Desktop/lacs}"
say() { printf '  %s\n' "$1"; }
die() { printf 'maintainer-repo: %s\n' "$1" >&2; exit 1; }

cmd_prune() {
    local dry=0; [ "${1:-}" = "--dry-run" ] && dry=1
    cd "$REPO_PATH" || die "no repo at $REPO_PATH"
    git fetch -q --prune origin || die "fetch failed"

    # Never touch a branch that still has an open pull request. A branch can be
    # merged into main and still be the head of a second, open PR.
    local open_heads
    open_heads="$(gh pr list --repo "$REPO_SLUG" --state open --json headRefName --jq '.[].headRefName' 2>/dev/null | tr '\n' '|')"

    say "remote branches merged into main:"
    local n=0
    while read -r br; do
        [ -z "$br" ] && continue
        case "$br" in main|master|HEAD) continue ;; esac
        [ -n "$open_heads" ] && printf '%s' "$open_heads" | grep -qx -F -- "$br" 2>/dev/null && { say "  keep   $br (open PR)"; continue; }
        # Merged means: its tip is an ancestor of origin/main.
        if git merge-base --is-ancestor "origin/$br" origin/main 2>/dev/null; then
            n=$((n+1))
            if [ "$dry" = 1 ]; then say "  would delete $br"
            else
                if git push -q origin --delete "$br" 2>/dev/null; then say "  deleted $br"
                else say "  could not delete $br (protected or already gone)"; fi
            fi
        fi
    done < <(git for-each-ref --format='%(refname:strip=3)' refs/remotes/origin)
    [ "$n" = 0 ] && say "  none"

    say "local branches fully merged into main:"
    local m=0
    while read -r br; do
        [ -z "$br" ] && continue
        case "$br" in main|master) continue ;; esac
        if git merge-base --is-ancestor "$br" origin/main 2>/dev/null; then
            m=$((m+1))
            if [ "$dry" = 1 ]; then say "  would delete $br"
            else git branch -D "$br" >/dev/null 2>&1 && say "  deleted $br"; fi
        fi
    done < <(git for-each-ref --format='%(refname:strip=2)' refs/heads)
    [ "$m" = 0 ] && say "  none"
    [ "$dry" = 0 ] && { git worktree prune; git remote prune origin >/dev/null 2>&1; say "worktrees and remote refs pruned"; }
}

cmd_release_check() {
    cd "$REPO_PATH" || die "no repo at $REPO_PATH"
    git fetch -q --tags origin
    local tag; tag="$(git describe --tags --abbrev=0 origin/main 2>/dev/null)" || die "no tags"
    local n; n="$(git rev-list --count "$tag"..origin/main)"
    say "last tag: $tag"
    say "commits since: $n"
    [ "$n" = 0 ] && { say "verdict: nothing to release"; return 0; }

    printf '\n'
    git log --oneline "$tag"..origin/main | sed 's/^/    /'
    printf '\n'

    # The CHANGELOG's Unreleased section is the authoritative signal, because a
    # human wrote it deliberately to say what changed. Commit subjects are not:
    # an earlier version of this check read subject lines for the word
    # "security" and scored a genuine authorization fix as zero, because its
    # subject was "fix(daemon): gate mutating query actions".
    local prod unrel sec added breaking
    prod="$(git diff --name-only "$tag"..origin/main -- 'crates/*/src/*' 'apps/*/src/*' | wc -l)"
    unrel="$(sed -n '/^## \[Unreleased\]/,/^## \[[0-9]/p' CHANGELOG.md 2>/dev/null)"
    sec="$(printf '%s' "$unrel" | grep -c '^### Security' || true)"
    added="$(printf '%s' "$unrel" | grep -c '^### Added' || true)"
    # "no longer", "can no longer", "used to" are how this project words a
    # removed capability, which docs/release.md counts as a break.
    breaking="$(printf '%s' "$unrel" | grep -ciE 'no longer|used to (succeed|work)|refuses' || true)"
    say "production files touched:  $prod"
    say "CHANGELOG Security section: $([ "$sec" -gt 0 ] && echo yes || echo no)"
    say "CHANGELOG Added section:    $([ "$added" -gt 0 ] && echo yes || echo no)"
    say "removed-capability wording: $breaking occurrence(s)"
    if [ -z "$unrel" ]; then
        say "WARNING: the Unreleased section is empty or unreadable, so this verdict"
        say "         rests on file counts alone. Check CHANGELOG.md by hand."
    fi

    printf '\n'
    if [ "$prod" = 0 ]; then
        say "verdict: docs and tests only. A release is optional."
    elif [ "$sec" -gt 0 ] || [ "$breaking" -gt 0 ]; then
        say "verdict: RELEASE DUE. A fix that removes a capability, or a security"
        say "         fix, is sitting unreleased, so every installed copy is still"
        say "         affected."
    else
        say "verdict: release worthwhile; production code changed."
    fi
    if [ "$breaking" -gt 0 ] || [ "$sec" -gt 0 ]; then
        say "digit:   middle. Something that used to succeed now refuses, which"
        say "         docs/release.md counts as a break in the 0.y series."
    else
        say "digit:   last. Compatible additions and fixes."
    fi
    say ""
    say "Cutting one is a human decision: crates.io and npm versions can never be"
    say "replaced. See docs/release.md for the fifteen version sites."
}

case "${1:-}" in
    prune)         shift; cmd_prune "$@" ;;
    release-check) shift; cmd_release_check "$@" ;;
    *) printf 'usage: maintainer-repo {prune [--dry-run]|release-check}\n' >&2; exit 64 ;;
esac
