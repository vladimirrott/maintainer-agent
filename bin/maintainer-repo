#!/usr/bin/env bash
# Repository housekeeping a maintainer does after every merge, and a release
# check that says whether one is owed.
#
#   maintainer-repo prune [--dry-run]    delete merged branches, local and remote
#   maintainer-repo release-check        is a release due, and what digit moves
#   maintainer-repo fixup <pr> [--dry-run]  finish a stalled pull request's mechanical items
#
# Both exist because they are the chores a solo maintainer stops doing first,
# and both are cheap to get wrong by hand: a branch deleted while a PR is still
# open, or a security fix left sitting unreleased on main.
set -uo pipefail

. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/profile.sh" 2>/dev/null \
  || . "$HOME/.local/share/maintainer/profile.sh"
maintainer_load_profile || exit 64
REPO_SLUG="$MAINTAINER_SLUG"
REPO_PATH="$MAINTAINER_REPO"
say() { printf '  %s\n' "$1"; }
# A rehearsal that deletes a remote branch is not a rehearsal. run.sh exports
# this; a deny rule cannot enforce it, because the push happens inside this
# script rather than in a command the agent typed.
POST="${MAINTAINER_POST:-on}"
die() { printf 'maintainer-repo: %s\n' "$1" >&2; exit 1; }

cmd_prune() {
    local dry=0; [ "${1:-}" = "--dry-run" ] && dry=1
    if [ "$POST" = off ]; then
        dry=1
        say "POST=off: listing only, nothing will be deleted"
    fi
    cd "$REPO_PATH" || die "no repo at $REPO_PATH"
    git fetch -q --prune origin || die "fetch failed"

    # Never touch a branch that still has an open pull request. A branch can be
    # merged into main and still be the head of a second, open PR.
    local open_heads
    open_heads="$(gh pr list --repo "$REPO_SLUG" --state open --json headRefName --jq '.[].headRefName' 2>/dev/null | tr '\n' '|')"

    say "remote branches merged into main:"
    local n=0
    while read -r br; do
        [ -z "$br" ] && continue
        case "$br" in main|master|HEAD) continue ;; esac
        [ -n "$open_heads" ] && printf '%s' "$open_heads" | grep -qx -F -- "$br" 2>/dev/null && { say "  keep   $br (open PR)"; continue; }
        # Merged means: its tip is an ancestor of origin/main.
        if git merge-base --is-ancestor "origin/$br" origin/main 2>/dev/null; then
            n=$((n+1))
            if [ "$dry" = 1 ]; then say "  would delete $br"
            else
                if git push -q origin --delete "$br" 2>/dev/null; then say "  deleted $br"
                else say "  could not delete $br (protected or already gone)"; fi
            fi
        fi
    done < <(git for-each-ref --format='%(refname:strip=3)' refs/remotes/origin)
    [ "$n" = 0 ] && say "  none"

    say "local branches fully merged into main:"
    local m=0
    while read -r br; do
        [ -z "$br" ] && continue
        case "$br" in main|master) continue ;; esac
        if git merge-base --is-ancestor "$br" origin/main 2>/dev/null; then
            m=$((m+1))
            if [ "$dry" = 1 ]; then say "  would delete $br"
            else git branch -D "$br" >/dev/null 2>&1 && say "  deleted $br"; fi
        fi
    done < <(git for-each-ref --format='%(refname:strip=2)' refs/heads)
    [ "$m" = 0 ] && say "  none"
    [ "$dry" = 0 ] && { git worktree prune; git remote prune origin >/dev/null 2>&1; say "worktrees and remote refs pruned"; }
}

cmd_release_check() {
    cd "$REPO_PATH" || die "no repo at $REPO_PATH"
    git fetch -q --tags origin
    local tag; tag="$(git describe --tags --abbrev=0 origin/main 2>/dev/null)" || die "no tags"
    local n; n="$(git rev-list --count "$tag"..origin/main)"
    say "last tag: $tag"
    say "commits since: $n"
    [ "$n" = 0 ] && { say "verdict: nothing to release"; return 0; }

    printf '\n'
    git log --oneline "$tag"..origin/main | sed 's/^/    /'
    printf '\n'

    # The CHANGELOG's Unreleased section is the authoritative signal, because a
    # human wrote it deliberately to say what changed. Commit subjects are not:
    # an earlier version of this check read subject lines for the word
    # "security" and scored a genuine authorization fix as zero, because its
    # subject was "fix(daemon): gate mutating query actions".
    local prod shipped unrel sec added breaking
    # Same fix as the merge gate: these were sysknife's directories, so on any
    # other repository the count was zero and every release looked like "docs
    # and tests only".
    local -a globs; read -r -a globs <<< "${PROD_GLOBS:-}"
    if [ "${#globs[@]}" -eq 0 ]; then
        say "WARNING: this profile declares no PROD_GLOBS, so the production-file"
        say "         count below is meaningless. Set it in profile.env."
        prod=0
    else
        prod="$(git diff --name-only "$tag"..origin/main -- "${globs[@]}" | wc -l)"
    fi
    # PROD_GLOBS is the receipt-invalidation set, so it contains CI: a workflow
    # change has to invalidate a receipt. It is the wrong set for a release
    # decision, because a gate that now refuses does not reach anybody who
    # installed the last version. On 2026-09-28 sysknife merged five docs-and-CI
    # pull requests, three CHANGELOG entries said a gate "refuses", and this
    # answered RELEASE DUE with a middle digit while nothing under crates/,
    # apps/ or packages/ had moved since the tag. That release would have
    # published byte-identical artifacts, and a crates.io version can never be
    # replaced.
    local -a ship; read -r -a ship <<< "${SHIPPED_GLOBS:-}"
    if [ "${#ship[@]}" -eq 0 ]; then
        say "WARNING: this profile declares no SHIPPED_GLOBS, so nothing below can say"
        say "         whether the change reaches an installed copy. Set it in"
        say "         profile.env. Unset is not the same as untouched."
        shipped=""
    else
        shipped="$(git diff --name-only "$tag"..origin/main -- "${ship[@]}" | wc -l)"
    fi
    # Read from the working tree, because that is the file a human is about to
    # tag, while every count above comes from origin/main. Those are two trees,
    # and the verdict is only about one of them when they agree. Say which, and
    # say when they do not: this check ran against a CHANGELOG whose Unreleased
    # section had already been promoted to a version heading and reported "0
    # removed-capability occurrences" for a release that removed six.
    say "CHANGELOG read from:        the working tree ($(git rev-parse --abbrev-ref HEAD))"
    if [ -n "$(git status --porcelain CHANGELOG.md)" ]; then
        say "                           uncommitted, so origin/main does not have it yet"
    elif ! git merge-base --is-ancestor HEAD origin/main 2>/dev/null; then
        say "                           HEAD is not on origin/main; the counts above are"
    else
        # Being an ancestor is exactly the STALE case, and the check above reads
        # it as healthy. On 2026-09-22 this answered `digit: last` for a release
        # whose Unreleased section drops Node 18 and 20 support, because the
        # checkout was four commits behind and that entry was not in the file it
        # read. Publishing a break as a patch hands it to everyone pinned to the
        # series, which is the one outcome docs/release.md exists to prevent.
        local _behind
        _behind="$(git rev-list --count HEAD..origin/main 2>/dev/null || printf 0)"
        if [ "${_behind:-0}" -gt 0 ]; then
            say "                           HEAD is $_behind commit(s) BEHIND origin/main, so this"
            say "                           is NOT the CHANGELOG you are about to tag. Pull, then"
            say "                           run this again; the digit below may be wrong."
        fi
    fi
    # The two heading lines are dropped, because sed prints both delimiters. An
    # empty Unreleased section therefore came back as two lines, `-z` was false,
    # and the "this verdict rests on file counts alone" warning below never
    # printed once. It reported "0 removed-capability occurrences" for a release
    # that removed six, without saying it had read nothing.
    unrel="$(sed -n '/^## \[Unreleased\]/,/^## \[[0-9]/p' CHANGELOG.md 2>/dev/null \
             | grep -v '^## \[')"
    sec="$(printf '%s' "$unrel" | grep -c '^### Security' || true)"
    added="$(printf '%s' "$unrel" | grep -c '^### Added' || true)"
    # "no longer", "can no longer", "used to" are how this project words a
    # removed capability, which docs/release.md counts as a break.
    breaking="$(printf '%s' "$unrel" | grep -ciE 'no longer|used to (succeed|work)|refuses' || true)"
    say "production files touched:  $prod"
    if [ -n "$shipped" ]; then
        say "shipped surface touched:    $shipped"
        if [ "$shipped" -eq 0 ]; then
            say "                           nothing that installs has changed since $tag, so a"
            say "                           release would publish byte-identical artifacts and"
            say "                           any break named below is in CI, not in the product."
        fi
    fi
    say "CHANGELOG Security section: $([ "$sec" -gt 0 ] && echo yes || echo no)"
    say "CHANGELOG Added section:    $([ "$added" -gt 0 ] && echo yes || echo no)"
    say "removed-capability wording: $breaking occurrence(s)"
    if [ -z "$(printf '%s' "$unrel" | tr -d '[:space:]')" ]; then
        say "WARNING: the Unreleased section is empty, so the three lines above read"
        say "         nothing and this verdict rests on file counts alone."
        local top; top="$(grep -m1 '^## \[[0-9]' CHANGELOG.md 2>/dev/null)"
        [ -n "$top" ] && say "         The newest version heading is '${top#\#\# }'. If you have already"
        [ -n "$top" ] && say "         promoted Unreleased into it, read that section instead."
    fi

    printf '\n'
    if [ "$prod" = 0 ]; then
        say "verdict: docs and tests only. A release is optional."
    elif [ "$sec" -gt 0 ] || [ "$breaking" -gt 0 ]; then
        say "verdict: RELEASE DUE. A fix that removes a capability, or a security"
        say "         fix, is sitting unreleased, so every installed copy is still"
        say "         affected."
    else
        say "verdict: release worthwhile; production code changed."
    fi
    if [ "$breaking" -gt 0 ] || [ "$sec" -gt 0 ]; then
        say "digit:   middle. Something that used to succeed now refuses, which"
        say "         docs/release.md counts as a break in the 0.y series."
    else
        say "digit:   last. Compatible additions and fixes."
    fi
    say ""
    say "Cutting one is a human decision: crates.io and npm versions can never be"
    say "replaced."
}

# Finish a pull request the author has left on mechanical review items.
#
# Every decision is `maintainer fixup-check`'s, asked again here at the current
# head; this function only does the git. It works in a scratch clone of the
# contributor's branch, with no hook and no contributor code run, and it never
# labels, closes, approves, merges or touches a claim.
cmd_fixup() {
    local pr="" dry=0 a
    for a in "$@"; do
        case "$a" in
            --dry-run) dry=1 ;;
            *[!0-9]*|"") pr="" ; break ;;
            *) pr="$a" ;;
        esac
    done
    [ -n "$pr" ] || { printf 'usage: maintainer-repo fixup <pr> [--dry-run]\n' >&2; exit 64; }
    if [ "$POST" = off ]; then
        dry=1
        say "POST=off: rehearsing, nothing will be posted or pushed"
    fi
    local here; here="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
    local out; out="$(python3 "$here/maintainer" fixup-check "$pr")" || exit 1
    local state head base branch fork author items patch marker notice_due notice_days
    state="$(sed -n 's/^state=//p' <<<"$out")"
    head="$(sed -n 's/^head=//p' <<<"$out")"
    base="$(sed -n 's/^base=//p' <<<"$out")"
    branch="$(sed -n 's/^branch=//p' <<<"$out")"
    fork="$(sed -n 's/^fork=//p' <<<"$out")"
    author="$(sed -n 's/^author=//p' <<<"$out")"
    items="$(sed -n 's/^items=//p' <<<"$out")"
    patch="$(sed -n 's/^patch=//p' <<<"$out")"
    marker="$(sed -n 's/^notice_marker=//p' <<<"$out")"
    notice_due="$(sed -n 's/^notice_due=//p' <<<"$out")"
    notice_days="$(sed -n 's/^notice_days=//p' <<<"$out")"
    [ -n "$state" ] && [ -n "$head" ] && [ -n "$branch" ] && [ -n "$fork" ] && [ -n "$items" ] \
        || die "fixup-check answered without a state, head, branch, fork or items; refusing to act on that"

    # Who is acting. The same rule as the merge gate: a write that succeeds
    # under the wrong account is worse than one that fails.
    gh auth switch --hostname github.com --user "$MAINTAINER_ACCOUNT" >/dev/null 2>&1
    local me me_id me_login
    me="$(gh api user --jq '[.id,.login]|@tsv' 2>/dev/null)" || die "gh could not confirm an account"
    me_id="${me%%$'\t'*}"; me_login="${me#*$'\t'}"
    case "$me_id" in ''|*[!0-9]*) die "gh did not return a numeric account id" ;; esac
    [ "${me_login,,}" = "${MAINTAINER_ACCOUNT,,}" ] || die "gh is authenticated as '$me_login', not $MAINTAINER_ACCOUNT"

    if [ "$state" = notice ]; then
        local kinds; kinds="$(tr ' ' '\n' <<<"$items" | sed 's/:.*//' | paste -sd, - | sed 's/,/, /g')"
        local body; body="$(printf 'This has had no reply for %s days since my review, and what is left is mechanical (%s).\n\nI will push a fixup for it to your branch after %s unless you push first. Your commits stay yours, and I will credit you on anything I add. If you would rather do it yourself, push or reply and I will leave it alone.\n\n%s\n' \
            "$(sed -n 's/^review_age=//p' <<<"$out")" "$kinds" "$notice_due" "$marker")"
        if [ "$dry" = 1 ]; then
            say "would post this heads-up on #$pr (ripe after $notice_due, $notice_days days):"
            printf '%s\n' "$body" | sed 's/^/    /'
            return 0
        fi
        local nf; nf="$(mktemp "${MAINTAINER_STATE:?}/fixup-notice.XXXXXX")" || die "no scratch file"
        printf '%s' "$body" > "$nf"
        gh pr comment "$pr" --repo "$REPO_SLUG" --body-file "$nf" >/dev/null 2>&1; local rc=$?
        rm -f "$nf"
        [ "$rc" = 0 ] || die "could not post the heads-up on #$pr"
        # Posting is not the same as it being there. Ask again: the heads-up
        # must now be on the pull request and counted, or nothing was said.
        local again; again="$(python3 "$here/maintainer" fixup-check "$pr" 2>&1)"
        grep -qE 'heads-up is not ripe|^state=ready$' <<<"$again" \
            || die "posted the heads-up but could not read it back on #$pr, so I cannot say the author was told"
        say "posted the heads-up on #$pr; a fixup may follow after $notice_due"
        return 0
    fi

    # Past this point a push is possible. A scratch clone, never REPO_PATH.
    local work; work="$(mktemp -d "${MAINTAINER_STATE:?}/fixup-XXXXXX")" || die "no scratch directory"
    # shellcheck disable=SC2064
    trap "rm -rf '$work'" EXIT
    local url="https://github.com/$fork.git" burl="https://github.com/$REPO_SLUG.git"
    export GIT_TERMINAL_PROMPT=0 GIT_EDITOR=true
    # -c core.hooksPath=/dev/null on every command: a hook is contributor-
    # controlled text the moment it is in the tree, and this runs git only.
    g() { git -C "$work/r" -c core.hooksPath=/dev/null -c commit.gpgsign=false -c core.fsmonitor=false "$@"; }
    git -c core.hooksPath=/dev/null clone -q --no-tags --branch "$branch" --single-branch -- "$url" "$work/r" 2>/dev/null \
        || die "could not clone $fork $branch"
    [ "$(g rev-parse HEAD)" = "$head" ] \
        || die "$branch has moved since the check (now $(g rev-parse --short HEAD), checked $head); nothing was pushed"
    local committer="$me_login <$me_id+$me_login@users.noreply.github.com>"
    export GIT_COMMITTER_NAME="$me_login" GIT_COMMITTER_EMAIL="$me_id+$me_login@users.noreply.github.com"
    export GIT_AUTHOR_NAME="$me_login" GIT_AUTHOR_EMAIL="$me_id+$me_login@users.noreply.github.com"
    local rewriting=0 it kind
    for it in $items; do
        kind="${it%%:*}"
        if [ "$kind" = rebase ]; then
            rewriting=1
            g remote add base "$burl"
            g fetch -q base "$base" 2>/dev/null || die "could not fetch $base from $REPO_SLUG"
            if ! g rebase -q "refs/remotes/base/$base" >/dev/null 2>&1; then
                g rebase --abort >/dev/null 2>&1
                die "the rebase onto $base conflicts. Resolving conflicts is not automated; nothing was pushed"
            fi
        fi
    done
    local nonrebase; nonrebase="$(tr ' ' '\n' <<<"$items" | sed 's/:.*//' | grep -v '^rebase$' | sort -u | paste -sd, - | sed 's/,/, /g')"
    if [ -n "$nonrebase" ]; then
        [ -n "$patch" ] && [ -f "$patch" ] || die "no patch for: $nonrebase"
        g apply --check "$patch" >/dev/null 2>&1 || die "the patch does not apply to $branch after any rebase; nothing was pushed"
        g apply --index "$patch" >/dev/null 2>&1 || die "git apply failed on the patch; nothing was pushed"
        if grep -q 'test-count' <<<"$items"; then
            # A count is derived by the profile's own command, from the tree the
            # fixup would leave, never typed by a person or a model.
            [ -n "${FIXUP_COUNT_CMD:-}" ] \
                || die "this profile declares no FIXUP_COUNT_CMD, so a test count would be typed rather than derived"
            local n; n="$(cd "$work/r" && env -u GH_TOKEN -u GITHUB_TOKEN timeout 120 bash -c "$FIXUP_COUNT_CMD" 2>/dev/null | tr -d '[:space:]')"
            case "$n" in ''|*[!0-9]*) die "FIXUP_COUNT_CMD did not print a whole number, so no count could be derived" ;; esac
            g diff --cached -U0 | grep -E '^\+[^+]' | grep -Eq "(^|[^0-9])$n([^0-9]|\$)" \
                || die "the patch does not state $n, the count FIXUP_COUNT_CMD derives; a typed count is refused"
        fi
        local au; au="$(gh api "users/$author" --jq '[.id,.login]|@tsv' 2>/dev/null)" || die "could not look up $author"
        local au_id="${au%%$'\t'*}" au_login="${au#*$'\t'}"
        case "$au_id" in ''|*[!0-9]*) die "gh did not return a numeric id for $author" ;; esac
        [ "${au_login,,}" = "${author,,}" ] || die "the API answered for '$au_login', not $author"
        local -a so=()
        g log -n 50 --format=%B "$head" | grep -q '^Signed-off-by:' && so=(-s)
        g commit -q "${so[@]}" -m "fixup: $nonrebase from the review" \
            -m "Co-authored-by: $au_login <$au_id+$au_login@users.noreply.github.com>" >/dev/null 2>&1 \
            || die "could not commit the patch"
    fi
    local new; new="$(g rev-parse HEAD)"
    [ "$new" != "$head" ] || die "the fixup would change nothing on $branch"

    say "plan: $items on $fork $branch, $(g rev-parse --short "$head") -> $(g rev-parse --short "$new"), as $committer"
    if [ "$dry" = 1 ]; then
        [ "$rewriting" = 1 ] && say "the branch would be rewritten (force-with-lease against $head)"
        g show --stat --patch --format=%B HEAD | sed 's/^/    /'
        say "rehearsal: nothing was pushed"
        return 0
    fi

    # A rewrite is leased against the head that was checked, so a push made
    # while this ran is never overwritten. Adding a commit is a plain push and
    # refuses by itself when the branch moved.
    if [ "$rewriting" = 1 ]; then
        g push -q --force-with-lease="refs/heads/$branch:$head" "$url" "HEAD:refs/heads/$branch" 2>/dev/null \
            || die "the push was refused (the branch moved, or the lease failed); nothing was overwritten"
    else
        g push -q "$url" "HEAD:refs/heads/$branch" 2>/dev/null \
            || die "the push was refused (the branch moved); nothing was overwritten"
    fi
    # Success is what the pull request reports, not what the push returned.
    local got="" tries="$GH_TRIES" i
    for ((i = 1; i <= tries; i++)); do
        got="$(gh pr view "$pr" --repo "$REPO_SLUG" --json headRefOid --jq .headRefOid 2>/dev/null)"
        [ "$got" = "$new" ] && break
        [ "$i" -lt "$tries" ] && sleep "$GH_BACKOFF"
    done
    [ "$got" = "$new" ] \
        || die "pushed $new but #$pr reports ${got:-nothing} as its head: NOT confirmed, look at it before anything else"
    say "fixup pushed to $fork $branch; #$pr is now at $new (read back from GitHub)"
}

case "${1:-}" in
    prune)         shift; cmd_prune "$@" ;;
    release-check) shift; cmd_release_check "$@" ;;
    fixup)         shift; cmd_fixup "$@" ;;
    *) printf 'usage: maintainer-repo {prune [--dry-run]|release-check|fixup <pr> [--dry-run]}\n' >&2; exit 64 ;;
esac
