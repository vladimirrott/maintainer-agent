# sysknife maintainer profile.
#
# Every site-specific value lives here. lib/run.sh reads it and stays generic,
# so a second repository needs a second profile and no code change.

PROFILE_NAME="sysknife"
REPO_PATH="${MAINTAINER_REPO_PATH:-$HOME/Desktop/lacs}"
REPO_SLUG="lacs-project/sysknife"

# The account that must own every write. run.sh refuses to start as anyone else.
# This is not about permissions: a write that SUCCEEDS under the wrong account
# stamps an employer-linked identity onto personal open-source work.
MAINTAINER_NAME="Vladimir"
GH_ACCOUNT="vladimirrott"

STATE_DIR="${MAINTAINER_STATE_DIR:-$HOME/.local/state/sysknife-maint}"
HELPER="$HOME/.local/bin/maintainer"

# Tasks this profile runs, and the model each gets.
TASKS="review issues ci audit"
# The skill each task loads at runtime. Declared here so bin/maintainer carries
# no repository's names in its own source.
SKILL_review="sysknife-review"
SKILL_issues="sysknife-issues"
SKILL_ci="sysknife-ci-live-tests"
SKILL_audit="sysknife-issue-audit"
# Thinking budget per task, in tokens, exported by the claude backend as
# MAX_THINKING_TOKENS. Reasoning effort is not a flag; this is the mechanism.
# It costs money on every run and a review already costs about $4.50, so review
# thinks hard and the cheaper sweeps do not.
THINKING_review=31999
THINKING_issues=16000
THINKING_ci=16000
THINKING_audit=16000
MODEL_review="opus"
MODEL_issues="opus"
MODEL_ci="opus"
MODEL_audit="opus"

# The model this task's SUBAGENTS get, when a task fans out. Exported by
# lib/backends/claude.sh as CLAUDE_CODE_SUBAGENT_MODEL, which is a default: an
# agent definition carrying its own `model:` still wins, so a reviewer somebody
# deliberately wrote to need opus keeps it.
#
# Only `review` is declared. It is the task that fans out, across files and
# across review dimensions, and that fan-out is independent work of the kind
# sonnet does as well as opus at a fraction of the price. The main loop keeps
# opus and the 31999-token budget, because judgement and the decision to post
# live there. The sweeps spawn nothing, and a setting on them would read as
# though they did.
SUBAGENT_MODEL_review="sonnet"

# Prose discipline, applied to everything the agent publishes. On by default;
# this is an opt-OUT, so a run gets it unless someone deliberately turns it off.
# "raw" exists for debugging a prompt, not for shipping.
PROSE_STYLE="${MAINTAINER_PROSE_STYLE:-stop-slop}"

# claude | codex. See README for what each backend can and cannot contain.
BACKEND="${MAINTAINER_BACKEND:-claude}"

# Longest a single run may hold the shared lock, in seconds. One tree is shared
# by every task, so a long run must block the next rather than race it.
LOCK_WAIT=3600

# Minimum hours between two runs of the same task, enforced by run.sh rather
# than by the scheduler, because not every scheduler can express a cadence.
# launchd cannot say "every 5 days" at all, so the macOS agents fire daily and
# this is what actually holds them; cron's day-of-month stepping fires on the
# 31st and again on the 1st. Set below the nominal interval so a jittered or
# caught-up systemd run is never suppressed. MAINTAINER_FORCE=1 overrides.
MIN_HOURS_review=6      # nominal 12h
MIN_HOURS_issues=36     # nominal 2 days
MIN_HOURS_ci=60         # nominal 3 days
MIN_HOURS_audit=108     # nominal 5 days

# on | off. With POST=off the agent does the whole pass and reaches nobody: the
# deny wall blocks every GitHub write verb and the prompt says so. This profile
# is authorised to post; a new profile starts at off.
POST="${MAINTAINER_POST:-on}"

# Commands the prompts tell the agent to run. `maintainer-doctor` checks each
# one resolves, and the test suite refuses a prompt that names anything outside
# this list plus KNOWN_NAMES. The prompts once told an unattended run to call
# `sysknife-maint screen`, which had been renamed and no longer existed; the
# run reported a screen verdict for a command that could not have produced one.
REQUIRED_COMMANDS="maintainer maintainer-merge maintainer-repo gh git podman"

# Hyphenated names in the prompts that are NOT commands: skills the agent loads,
# labels it applies, crates it reads. Anything hyphenated in a prompt must be in
# one list or the other, so a renamed command cannot hide in prose.
KNOWN_NAMES="stop-slop sysknife-review sysknife-issues sysknife-ci-live-tests sysknife-issue-audit sysknife-cli twir-listed"

# Paths whose change invalidates a verification receipt, and which count as
# production for `maintainer-repo release-check`. Tests, docs and evidence
# artifacts may move between the head a receipt names and the head being merged;
# these may not. There is no default: a merge gate that guesses which paths are
# production will guess wrong on somebody's repository.
PROD_GLOBS="crates/*/src/* apps/*/src/* packaging/* .github/* */Cargo.toml Cargo.lock"
