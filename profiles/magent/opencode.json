{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "deny",
    "bash": {
      "*": "deny",
      "git status*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git diff*": "allow",
      "git fetch*": "allow",
      "git rev-parse*": "allow",
      "git rev-list*": "allow",
      "git ls-files*": "allow",
      "git branch*": "allow",
      "git checkout*": "allow",
      "git archive*": "allow",
      "git merge-base*": "allow",
      "git cat-file*": "allow",
      "git describe*": "allow",
      "gh pr view*": "allow",
      "gh pr list*": "allow",
      "gh pr diff*": "allow",
      "gh pr checks*": "allow",
      "gh pr review*": "allow",
      "gh pr comment*": "allow",
      "gh issue view*": "allow",
      "gh issue list*": "allow",
      "gh issue create*": "allow",
      "gh issue comment*": "allow",
      "gh issue edit*": "allow",
      "gh issue close*": "allow",
      "gh label*": "allow",
      "gh api repos/*": "allow",
      "gh api user*": "allow",
      "gh api search/*": "allow",
      "gh run list*": "allow",
      "gh api rate_limit*": "allow",
      "cargo *": "allow",
