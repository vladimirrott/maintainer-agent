      "*gh workflow run*": "deny",
      "*gh auth token*": "deny",
      "*gh secret*": "deny",
      "*gh api -X DELETE*": "deny",
      "*gh api --method DELETE*": "deny",
      "*curl*": "deny",
      "*wget*": "deny",
      "*maintainer-merge receipt*": "deny",
      "*.ssh*": "deny",
      "*.config/gh*": "deny",
      "*.aws*": "deny",
      "*.gnupg*": "deny",
      "*.netrc*": "deny",
      "*credentials*": "deny"
