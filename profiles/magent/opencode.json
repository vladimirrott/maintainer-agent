      "podman system migrate*": "allow",
      "npm test*": "allow",
      "npx *": "allow",
      "python3 *": "allow",
      "bash *": "allow",
      "maintainer *": "allow",
      "maintainer-merge verify*": "allow",
      "maintainer-merge merge*": "allow",
      "maintainer-merge show*": "allow",
      "ls*": "allow",
      "cat*": "allow",
      "head*": "allow",
      "tail*": "allow",
      "grep*": "allow",
      "rg*": "allow",
      "find*": "allow",
      "wc*": "allow",
      "sed*": "allow",
      "awk*": "allow",
      "sort*": "allow",
      "uniq*": "allow",
      "diff*": "allow",
      "jq*": "allow",
      "mktemp*": "allow",
      "mkdir*": "allow",
      "cp*": "allow",
      "tar*": "allow",
      "printf*": "allow",
