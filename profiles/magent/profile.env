# magent maintainer profile.
#
# Every site-specific value lives here. lib/run.sh reads it and stays generic,
# so a second repository needs a second profile and no code change.
#
# Generated by ./new-profile.sh. Read it once end to end before the first run:
# this file decides what an unattended agent does in your name.

PROFILE_NAME="magent"
REPO_PATH="${MAINTAINER_REPO_PATH:-$HOME/Desktop/maintainer-agent}"
REPO_SLUG="vladimirrott/maintainer-agent"

# The name the agent uses for you in a comment, and the account that must own
# every write. run.sh reads the login back and refuses to start as anyone else,
# because a write that SUCCEEDS under the wrong account is worse than a 403.
MAINTAINER_NAME="Vladimir"
GH_ACCOUNT="vladimirrott"

STATE_DIR="${MAINTAINER_STATE_DIR:-$HOME/.local/state/magent-maint}"
HELPER="$HOME/.local/bin/maintainer"

# Tasks this profile runs, and the model each gets.
TASKS="review issues"
MODEL_review="opus"
MODEL_issues="opus"

# Thinking budget per task, in tokens, exported by the claude backend as
# MAX_THINKING_TOKENS. Reasoning effort is not a flag; this is the mechanism,
# and a profile that omits it gets whatever the backend defaults to. This one
# omitted it, so the agent maintaining the merge gate thought less about it than
# the agent maintaining sysknife did.
THINKING_review=31999
THINKING_issues=16000

# Minimum hours between two runs of the same task, enforced by run.sh rather
# than by the scheduler. launchd cannot express "every N days" at all, and
# cron's day-of-month stepping fires on the 31st and again on the 1st. Keep
# these below the nominal interval so a jittered run is never suppressed.
MIN_HOURS_review=6
MIN_HOURS_issues=36

# on | off. START AT OFF. The agent does the whole pass, writes the report and
# the drafts, and reaches nobody: the deny wall blocks every GitHub write verb
# and the prompt says so. Read a week of reports, then decide.
POST="${MAINTAINER_POST:-off}"

# Prose discipline, applied to everything the agent publishes. Opt-OUT: a run
# gets it unless someone deliberately sets "raw", which exists for debugging a
# prompt rather than for shipping.
PROSE_STYLE="${MAINTAINER_PROSE_STYLE:-stop-slop}"

# claude | opencode | codex | cursor. See the README for what each can contain.
# Only claude and opencode can honour POST=off.
BACKEND="${MAINTAINER_BACKEND:-claude}"

# Longest a single run may hold the shared lock, in seconds. One tree is shared
# by every task, so a long run must block the next rather than race it.
LOCK_WAIT=3600

# Commands the prompts tell the agent to run. maintainer-doctor checks each one
# resolves; the test suite refuses a prompt that names a hyphenated word outside
# this list plus KNOWN_NAMES. A prompt once told a run to call a command that
# had been renamed, and the run reported a verdict it could not have obtained.
REQUIRED_COMMANDS="maintainer maintainer-merge maintainer-repo gh git"

# Hyphenated names in the prompts that are NOT commands: skills, labels, crates.
# `release-check` is a subcommand of maintainer-repo, not a command of its own.
KNOWN_NAMES="stop-slop release-check"

# Paths whose change invalidates a verification receipt, and which count as
# production for `maintainer-repo release-check`. Tests, docs and evidence
# artifacts may move between the head a receipt names and the head being merged;
# these may not. There is no default: a merge gate that guesses which paths are
# production will guess wrong on somebody's repository.
PROD_GLOBS="bin/* lib/* lib/backends/* scripts/* profiles/*/*.json profiles/*/*.env .github/* install.sh new-profile.sh"
